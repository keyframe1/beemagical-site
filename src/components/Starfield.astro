---
/**
 * Starfield.astro - the ambient sky island.
 * Static HTML: the gradient sky and three drifting nebulae (paint instantly).
 * Client island: three parallax star layers that react to mouse + scroll,
 * periodic shooting stars, the cursor sparkle trail, and a page-wide
 * slow-falling fae-dust layer of gold, cyan, and soft-white motes.
 * All decorative, pointer-events: none. Honors prefers-reduced-motion.
 */
---

<div class="sky" aria-hidden="true">
  <div class="neb a"></div>
  <div class="neb b"></div>
  <div class="neb c"></div>
</div>

<div id="stars" aria-hidden="true">
  <div class="layer l1"></div>
  <div class="layer l2"></div>
  <div class="layer l3"></div>
</div>

<div class="shooting-layer" aria-hidden="true"></div>
<div class="fae-dust" aria-hidden="true"></div>
<div class="sparkle-trail" aria-hidden="true"></div>

<style>
  .sky {
    position: fixed;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
    background:
      radial-gradient(ellipse 70% 50% at 20% 12%, rgba(74, 234, 255, 0.10), transparent 55%),
      radial-gradient(ellipse 60% 55% at 82% 72%, rgba(155, 48, 255, 0.16), transparent 55%),
      radial-gradient(circle at 50% 40%, var(--sky-1) 0%, var(--sky-2) 45%, var(--sky-3) 100%);
  }
  .neb { position: absolute; border-radius: 50%; filter: blur(75px); opacity: 0.42; mix-blend-mode: screen; }
  .neb.a { width: 520px; height: 520px; background: radial-gradient(circle, #2b6bd6, transparent 70%); top: -120px; left: -100px; animation: f1 26s ease-in-out infinite; }
  .neb.b { width: 480px; height: 480px; background: radial-gradient(circle, #9b30ff, transparent 70%); bottom: -150px; right: -120px; animation: f2 31s ease-in-out infinite; }
  .neb.c { width: 420px; height: 420px; background: radial-gradient(circle, #d946ef, transparent 72%); top: 44%; left: 55%; animation: f3 35s ease-in-out infinite; }

  #stars { position: fixed; inset: 0; z-index: 0; pointer-events: none; overflow: hidden; }
  #stars .layer { position: absolute; inset: -10%; will-change: transform; }

  .shooting-layer { position: fixed; inset: 0; z-index: 1; pointer-events: none; overflow: hidden; }
  .fae-dust { position: fixed; inset: 0; z-index: 1; pointer-events: none; overflow: hidden; }
  .sparkle-trail { position: fixed; inset: 0; z-index: 9000; pointer-events: none; overflow: hidden; }

  /* star + mote + sparkle base styles set inline by the island */
  :global(.star) { position: absolute; border-radius: 50%; background: #fff; }
  :global(.mote) { position: absolute; border-radius: 50%; top: 0; will-change: transform, opacity; }
  :global(.shoot) {
    position: absolute;
    height: 2px;
    width: 120px;
    background: linear-gradient(90deg, rgba(255, 255, 255, 0), #fff 60%, var(--cyan));
    border-radius: 2px;
    transform-origin: left center;
    filter: drop-shadow(0 0 6px rgba(74, 234, 255, 0.7));
    will-change: transform, opacity;
  }
  :global(.cursor-spark) {
    position: absolute;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    will-change: transform, opacity;
  }
</style>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  type LayerDef = { el: HTMLElement; count: number; sizeMin: number; sizeMax: number; mouse: number; scroll: number };

  function makeStars() {
    const layers: LayerDef[] = [
      { el: document.querySelector('.l1') as HTMLElement, count: 38, sizeMin: 0.6, sizeMax: 1.4, mouse: 6, scroll: 0.012 },
      { el: document.querySelector('.l2') as HTMLElement, count: 30, sizeMin: 1.0, sizeMax: 2.0, mouse: 14, scroll: 0.035 },
      { el: document.querySelector('.l3') as HTMLElement, count: 20, sizeMin: 1.6, sizeMax: 3.0, mouse: 26, scroll: 0.07 },
    ];
    for (const layer of layers) {
      if (!layer.el) continue;
      const frag = document.createDocumentFragment();
      for (let i = 0; i < layer.count; i++) {
        const d = document.createElement('div');
        d.className = 'star';
        const r = layer.sizeMin + Math.random() * (layer.sizeMax - layer.sizeMin);
        d.style.width = r + 'px';
        d.style.height = r + 'px';
        d.style.left = Math.random() * 100 + '%';
        d.style.top = Math.random() * 100 + '%';
        d.style.opacity = (0.15 + Math.random() * 0.55).toFixed(2);
        if (Math.random() > 0.82) {
          d.style.background = '#bfeaff';
          d.style.boxShadow = '0 0 6px #7fe3ff';
        }
        if (!reduce) {
          d.style.animation = `tw ${(2.5 + Math.random() * 4).toFixed(2)}s ease-in-out ${(Math.random() * 4).toFixed(2)}s infinite`;
        }
        frag.appendChild(d);
      }
      layer.el.appendChild(frag);
    }
    return layers;
  }

  const layers = makeStars();

  // ---------- fae dust: page-wide slow-falling motes ----------
  function makeDust() {
    if (reduce) return;
    const host = document.querySelector('.fae-dust');
    if (!host) return;
    const colors = ['#E9C46A', '#4AEAFF', '#F0EAD6'];
    const COUNT = window.innerWidth < 640 ? 34 : 60;
    const frag = document.createDocumentFragment();
    for (let i = 0; i < COUNT; i++) {
      const m = document.createElement('div');
      m.className = 'mote';
      const size = 1.5 + Math.random() * 3.5;
      const col = colors[(Math.random() * colors.length) | 0];
      const op = (0.35 + Math.random() * 0.5).toFixed(2);
      const dur = 16 + Math.random() * 22;
      const delay = -Math.random() * dur;
      m.style.left = Math.random() * 100 + '%';
      m.style.width = size + 'px';
      m.style.height = size + 'px';
      m.style.background = col;
      m.style.boxShadow = `0 0 ${(size * 2).toFixed(1)}px ${col}`;
      m.style.setProperty('--mote-op', op);
      m.style.setProperty('--mote-drift', (Math.random() * 40 - 20).toFixed(0) + 'px');
      m.style.animation = `faefall ${dur.toFixed(1)}s linear ${delay.toFixed(1)}s infinite, faetwinkle ${(2 + Math.random() * 3).toFixed(1)}s ease-in-out infinite`;
      frag.appendChild(m);
    }
    host.appendChild(frag);
  }
  makeDust();

  // ---------- parallax: mouse + scroll, rAF throttled ----------
  let mx = 0, my = 0, sy = window.scrollY;
  let ticking = false;
  function applyParallax() {
    ticking = false;
    for (const l of layers) {
      if (!l.el) continue;
      const tx = mx * l.mouse;
      const ty = my * l.mouse + sy * l.scroll;
      l.el.style.transform = `translate3d(${tx.toFixed(1)}px, ${ty.toFixed(1)}px, 0)`;
    }
  }
  function requestTick() {
    if (!ticking) { ticking = true; requestAnimationFrame(applyParallax); }
  }
  if (!reduce) {
    window.addEventListener('mousemove', (e) => {
      mx = (e.clientX / window.innerWidth - 0.5) * 2;
      my = (e.clientY / window.innerHeight - 0.5) * 2;
      requestTick();
    }, { passive: true });
    window.addEventListener('scroll', () => { sy = window.scrollY; requestTick(); }, { passive: true });
  }

  // ---------- shooting stars ----------
  function shoot() {
    const host = document.querySelector('.shooting-layer');
    if (!host) return;
    const s = document.createElement('div');
    s.className = 'shoot';
    const startX = 10 + Math.random() * 60;
    const startY = Math.random() * 40;
    s.style.left = startX + 'vw';
    s.style.top = startY + 'vh';
    const angle = 18 + Math.random() * 16;
    s.style.transform = `rotate(${angle}deg)`;
    host.appendChild(s);
    const dist = 40 + Math.random() * 30;
    const rad = (angle * Math.PI) / 180;
    s.animate(
      [
        { transform: `rotate(${angle}deg) translateX(0)`, opacity: 0 },
        { opacity: 1, offset: 0.15 },
        { transform: `rotate(${angle}deg) translateX(${dist}vw)`, opacity: 0 },
      ],
      { duration: 700 + Math.random() * 500, easing: 'ease-out' }
    ).onfinish = () => s.remove();
    void rad;
  }
  function scheduleShoot() {
    if (reduce) return;
    shoot();
    setTimeout(scheduleShoot, 4500 + Math.random() * 6000);
  }
  setTimeout(scheduleShoot, 2500);

  // ---------- cursor sparkle trail ----------
  if (!reduce) {
    const host = document.querySelector('.sparkle-trail');
    let last = 0;
    const palette = ['#4AEAFF', '#E9C46A', '#F0EAD6'];
    window.addEventListener('mousemove', (e) => {
      const now = performance.now();
      if (now - last < 28 || !host) return;
      last = now;
      const s = document.createElement('div');
      s.className = 'cursor-spark';
      const col = palette[(Math.random() * palette.length) | 0];
      const size = 3 + Math.random() * 5;
      s.style.width = size + 'px';
      s.style.height = size + 'px';
      s.style.background = col;
      s.style.boxShadow = `0 0 8px ${col}`;
      s.style.left = e.clientX + (Math.random() * 10 - 5) + 'px';
      s.style.top = e.clientY + (Math.random() * 10 - 5) + 'px';
      host.appendChild(s);
      s.animate(
        [
          { transform: 'translateY(0) scale(1)', opacity: 0.9 },
          { transform: `translateY(${10 + Math.random() * 14}px) scale(0)`, opacity: 0 },
        ],
        { duration: 650 + Math.random() * 300, easing: 'ease-out' }
      ).onfinish = () => s.remove();
    }, { passive: true });
  }
</script>
