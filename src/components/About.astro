---
/**
 * About.astro - two star-framed panels and three stats. The first panel is
 * Hannah's self-portrait, the artist image, rendered through astro:assets so
 * it is optimized and shown complete with its signature. The second is The
 * Return mid-paint, muted and looped, playing only on screen with the tab
 * visible, poster under reduced motion. No prices and no em dashes anywhere.
 */
import { Image } from 'astro:assets';
import selfPortrait from '../assets/art/bee-untitled-self.jpg';
---

<section id="about" class="section about">
  <div class="reveal">
    <h2 class="section-title">About</h2>
  </div>

  <div class="about-media reveal">
    <figure class="about-panel">
      <span class="ap-star tl" aria-hidden="true"></span>
      <span class="ap-star tr" aria-hidden="true"></span>
      <span class="ap-star bl" aria-hidden="true"></span>
      <span class="ap-star br" aria-hidden="true"></span>
      <Image
        class="about-portrait"
        src={selfPortrait}
        alt="A self-portrait of the artist, violet hair flowing into a field of stars"
        width={900}
        loading="lazy"
      />
      <figcaption class="ap-cap">Hannah, the artist behind Bee Magical.</figcaption>
    </figure>

    <figure class="about-panel">
      <span class="ap-star tl" aria-hidden="true"></span>
      <span class="ap-star tr" aria-hidden="true"></span>
      <span class="ap-star bl" aria-hidden="true"></span>
      <span class="ap-star br" aria-hidden="true"></span>
      <video
        class="about-clip"
        muted
        loop
        playsinline
        preload="metadata"
        poster="/video/celestial-process-poster.jpg"
        aria-hidden="true"
        data-autovideo
      >
        <source src="/video/celestial-process.webm" type="video/webm" />
        <source src="/video/celestial-process.mp4" type="video/mp4" />
      </video>
      <figcaption class="ap-cap">The Return, mid-paint. Every sky starts as a sketch.</figcaption>
    </figure>
  </div>

  <div class="stats">
    <div class="stat reveal"><span class="stat-big">Originals</span><span class="stat-sub">one of a kind</span></div>
    <div class="stat reveal"><span class="stat-big">Prints available</span><span class="stat-sub">open editions</span></div>
    <div class="stat reveal"><span class="stat-big">Ships worldwide</span><span class="stat-sub">packed with care</span></div>
  </div>
</section>

<style>
  /* two star-framed panels side by side, stacking on small screens */
  .about-media {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-3);
    max-width: 860px;
    margin: var(--space-4) auto 0;
    align-items: start;
  }
  /* the star-framed panel: glowing border, four corner stars */
  .about-panel {
    position: relative;
    margin: 0;
    padding: 0;
  }
  /* the self-portrait shows complete and uncropped so the whole piece and the
     signature read; the process clip fills its square frame. */
  .about-portrait,
  .about-clip {
    width: 100%;
    display: block;
    border: 1px solid rgba(233, 196, 106, 0.4);
    border-radius: var(--radius-md);
    box-shadow: var(--glow-gold), var(--shadow-card);
    background: #05071a;
  }
  .about-portrait { height: auto; }
  .about-clip { aspect-ratio: 1; height: auto; object-fit: cover; }
  .ap-star {
    position: absolute;
    width: 11px;
    height: 11px;
    background: radial-gradient(circle, #fff 0%, rgba(233, 196, 106, 0.9) 35%, transparent 70%);
    pointer-events: none;
    z-index: 1;
    animation: tw 3.6s ease-in-out infinite;
  }
  .ap-star.tl { top: -5px; left: -5px; }
  .ap-star.tr { top: -5px; right: -5px; animation-delay: 0.9s; }
  .ap-star.bl { bottom: 26px; left: -5px; animation-delay: 1.8s; }
  .ap-star.br { bottom: 26px; right: -5px; animation-delay: 2.7s; }
  .ap-cap {
    font-family: var(--font-body);
    font-weight: 300;
    font-size: 13px;
    letter-spacing: 0.06em;
    color: rgba(226, 232, 244, 0.55);
    text-align: center;
    margin-top: 12px;
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-2);
    max-width: 760px;
    margin: var(--space-4) auto 0;
  }
  .stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    padding: 22px 14px;
    border: 1px solid rgba(74, 234, 255, 0.18);
    border-radius: var(--radius-md);
    background: rgba(74, 234, 255, 0.04);
    text-align: center;
  }
  .stat-big { font-family: var(--font-head); font-size: clamp(18px, 2.4vw, 24px); color: var(--moon); }
  .stat-sub {
    font-family: var(--font-body);
    font-weight: 300;
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(226, 232, 244, 0.5);
  }

  @media (max-width: 640px) {
    .about-media { grid-template-columns: 1fr; max-width: 420px; gap: var(--space-2); }
    .stats { grid-template-columns: 1fr; max-width: 420px; }
    .stat { padding: 16px 14px; }
  }
</style>

<script>
  import { manageVideo } from '../lib/video-client';
  const clip = document.querySelector('.about-clip') as HTMLVideoElement | null;
  if (clip) manageVideo(clip, { group: 'ambient' });
</script>
