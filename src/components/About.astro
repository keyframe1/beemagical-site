---
/**
 * About.astro - the light interlude: heading, a short statement, and three
 * stat cards, with the aurora veil (Aurora.astro) drifting behind the whole
 * section as a soft full-section background. The looming self-portrait and
 * its cosmic thunder now live behind Contact, and the process time-lapse
 * lives in Commissions. No prices and no em dashes anywhere.
 */
import Aurora from './Aurora.astro';
---

<section id="about" class="section about">
  <Aurora />

  <div class="reveal">
    <h2 class="section-title">About</h2>
    <p class="section-desc">
      Hannah is a painter of bright, fae-touched creatures and deep night skies. Made in Louisiana.
    </p>
  </div>

  <div class="stats">
    <div class="stat reveal"><span class="stat-big">Originals</span><span class="stat-sub">one of a kind</span></div>
    <div class="stat reveal"><span class="stat-big">Prints available</span><span class="stat-sub">open editions</span></div>
    <div class="stat reveal"><span class="stat-big">Ships worldwide</span><span class="stat-sub">packed with care</span></div>
  </div>
</section>

<style>
  /* the section hosts the aurora veil; everything else stacks above it */
  .about { position: relative; }
  .about .reveal, .about .stats { position: relative; z-index: 1; }
  .about .section-title,
  .about .section-desc { text-shadow: 0 2px 18px rgba(3, 5, 14, 0.8); }

  .stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-2);
    max-width: 760px;
    margin: var(--space-4) auto 0;
  }
  .stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    padding: 22px 14px;
    border: 1px solid rgba(74, 234, 255, 0.18);
    border-radius: var(--radius-md);
    background: rgba(5, 7, 26, 0.55);
    text-align: center;
  }
  .stat-big { font-family: var(--font-head); font-size: clamp(18px, 2.4vw, 24px); color: var(--moon); }
  .stat-sub {
    font-family: var(--font-body);
    font-weight: 300;
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(226, 232, 244, 0.5);
  }

  @media (max-width: 640px) {
    .stats { grid-template-columns: 1fr; max-width: 420px; }
    .stat { padding: 16px 14px; }
  }
</style>
