---
/**
 * Contact.astro - the calm closer and the bottom of the page. No visible
 * heading: Hannah's self-portrait is the silent focal point, with a
 * visually-hidden h2 keeping the anchor and document outline for screen
 * readers. The painting's top third is empty sky and her face sits low in
 * the frame, so the image keeps its natural aspect, scaled large and lifted
 * with a negative top offset to put her face in the upper-center, with a
 * clear breath of sky between her chin and the invitation below. Screen blend
 * merges the painting's dark starry ground into the page sky and a radial
 * mask dissolves every edge; nothing opaque covers her face. A quiet
 * presence at rest; every 9 to 16 seconds a soft cosmic-thunder flash eases
 * her up with a cyan and violet glow and a faint lightning streak, holds a
 * breath, then fades back over about a second. Soft attack only, never an
 * instant strobe, gated to the section being in view and the tab visible,
 * opacity only. Reduced motion: no flashing, fixed gentle opacity.
 * There is no backend, so there is no form here: one that accepted a message
 * and sent it nowhere would be worse than none. The section closes on a
 * single clear invitation into Ko-fi commissions, with her address plain
 * underneath for anyone who would rather just write. Both destinations come
 * from lib/links.ts. The constellation language stays: the button is traced
 * by a faint cyan-into-violet line anchored by glowing corner stars (the same
 * star-dot language as the gallery and commission cards), brightening on
 * hover and focus. The form markup is parked whole in ContactForm.astro,
 * rendered by nothing, until there is somewhere for it to post. The external
 * links (Instagram, Ko-fi) live in the nav and the footer, not here. No em
 * dashes in any copy.
 */
import { Image } from 'astro:assets';
import selfPortrait from '../assets/art/bee-untitled-self.jpg';
import { KOFI_COMMISSIONS, EMAIL, EMAIL_HREF } from '../lib/links';
---

<section id="contact" class="contact-shell">
  <!-- the looming portrait: blended, masked, opacity-animated only -->
  <div class="presence" aria-hidden="true">
    <Image
      class="presence-img"
      src={selfPortrait}
      alt=""
      widths={[320, 480, 640, 760, 940, 1280]}
      sizes="(min-width: 1271px) 940px, 74vw"
      format="webp"
      loading="lazy"
    />
    <div class="presence-glow"></div>
    <div class="presence-bolt b1"></div>
    <div class="presence-bolt b2"></div>
  </div>

  <div class="section contact">
    <h2 class="sr-only">Contact</h2>

    <div class="ccta reveal">
      <a class="btn cbtn" href={KOFI_COMMISSIONS} target="_blank" rel="noopener noreferrer">
        Commission me on Ko-fi
        <i class="fstar tl" aria-hidden="true"></i>
        <i class="fstar tr" aria-hidden="true"></i>
        <i class="fstar bl" aria-hidden="true"></i>
        <i class="fstar br" aria-hidden="true"></i>
      </a>
      <p class="cmail-alt">or email <a class="cmail" href={EMAIL_HREF}>{EMAIL}</a></p>
    </div>
  </div>
</section>

<style>
  /* full-bleed stage for the portrait; the content column sits inside */
  .contact-shell {
    position: relative;
    overflow: hidden;
  }

  /* visually hidden but present for screen readers and the outline */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  /* ---------- the looming presence ---------- */
  .presence {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    z-index: 0;
  }
  /* screen blend lets the painting's own dark starry ground vanish into the
     page sky; the radial mask hugs her head and halo (her face sits around
     58% down the painting) so every edge and the signature dissolve. The
     negative top crops the painting's empty upper sky out of the section,
     landing her face in the open upper-center, the hero of the section,
     with the form a clear breath below her chin. */
  .presence-img {
    position: absolute;
    left: 50%;
    top: clamp(-160px, calc(-11.3vw - 6px), -20px);
    transform: translateX(-50%);
    width: clamp(320px, 74vw, 940px);
    height: auto;
    mix-blend-mode: screen;
    opacity: 0.2;
    mask-image: radial-gradient(ellipse 46% 42% at 50% 62%, #000 42%, transparent 76%);
    -webkit-mask-image: radial-gradient(ellipse 46% 42% at 50% 62%, #000 42%, transparent 76%);
    will-change: opacity;
  }
  /* cyan and violet storm light that wakes with each flash, centered on her */
  .presence-glow {
    position: absolute;
    inset: 0;
    opacity: 0;
    mix-blend-mode: screen;
    background:
      radial-gradient(ellipse 38% 30% at 44% 20%, rgba(74, 234, 255, 0.4), transparent 70%),
      radial-gradient(ellipse 42% 34% at 57% 28%, rgba(155, 48, 255, 0.42), transparent 70%);
    will-change: opacity;
  }
  /* faint cosmic lightning: thin blurred streaks near her, opacity only */
  .presence-bolt {
    position: absolute;
    width: 3px;
    height: 32%;
    top: 2%;
    opacity: 0;
    border-radius: 3px;
    background: linear-gradient(to bottom,
      transparent 0%,
      rgba(240, 234, 214, 0.9) 18%,
      rgba(74, 234, 255, 0.8) 55%,
      rgba(155, 48, 255, 0.5) 82%,
      transparent 100%);
    filter: blur(1.5px) drop-shadow(0 0 12px rgba(74, 234, 255, 0.7)) drop-shadow(0 0 28px rgba(155, 48, 255, 0.5));
    will-change: opacity;
  }
  .presence-bolt.b1 { left: 35%; transform: rotate(14deg); }
  .presence-bolt.b2 { left: 64%; transform: rotate(-11deg); height: 26%; top: 7%; }

  /* ---------- the content column ---------- */
  .contact {
    position: relative;
    z-index: 1;
    max-width: 760px;
  }

  /* the invitation floats on the sky below her: the space above it holds her
     face plus a comfortable gap under her chin, so she reads as the hero and
     the call to action waits beneath. No panel and no solid fill anywhere. */
  .ccta {
    margin-top: clamp(160px, calc(34.9vw + 41px), 520px);
  }

  /* corner stars: the anchors of the constellation, matching the star-dot
     nodes on the gallery and commission cards. The twinkle lives on the
     inner pseudo so hover and focus can scale and brighten the dot itself. */
  .fstar {
    position: absolute;
    width: 9px;
    height: 9px;
    opacity: 0.65;
    transition: opacity 0.3s ease, transform 0.3s ease;
    pointer-events: none;
    z-index: 1;
  }
  .fstar::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(circle, #fff 0%, rgba(74, 234, 255, 0.9) 40%, transparent 70%);
    animation: tw 3.4s ease-in-out infinite;
  }
  .fstar.tl { top: -4px; left: -4px; }
  .fstar.tr { top: -4px; right: -4px; }
  .fstar.bl { bottom: -4px; left: -4px; }
  .fstar.br { bottom: -4px; right: -4px; }
  .fstar.tr::before { animation-delay: 0.8s; }
  .fstar.bl::before { animation-delay: 1.7s; }
  .fstar.br::before { animation-delay: 2.5s; }
  /* the twinkle runs only while the section is on screen with the tab
     visible; reduced motion stops it globally, leaving static dots */
  .contact-shell:not(.lit) .fstar::before,
  :global(html.tab-hidden) .fstar::before {
    animation-play-state: paused;
  }

  /* the button keeps its pill shape and gains the constellation: a faint
     pill-traced ring and corner stars, brightening on hover/focus */
  .cbtn {
    cursor: pointer;
    border-color: transparent;
  }
  .cbtn::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--radius-pill);
    padding: 1px;
    background: linear-gradient(135deg,
      rgba(74, 234, 255, 0.55),
      rgba(155, 48, 255, 0.4) 50%,
      rgba(217, 70, 239, 0.5));
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    mask-composite: exclude;
    opacity: 0.6;
    transition: opacity 0.3s ease;
    pointer-events: none;
  }
  .cbtn:hover::before,
  .cbtn:focus-visible::before { opacity: 1; }
  .cbtn:hover .fstar,
  .cbtn:focus-visible .fstar { opacity: 1; transform: scale(1.25); }

  /* the quiet direct-email fallback under the button */
  .cmail-alt {
    margin-top: 16px;
    font-family: var(--font-body);
    font-weight: 300;
    font-size: 14px;
    color: rgba(226, 232, 244, 0.6);
    text-shadow: 0 1px 8px rgba(3, 5, 14, 0.9);
  }
  .cmail-alt .cmail {
    color: var(--cyan);
    text-decoration: none;
    border-bottom: 1px solid rgba(74, 234, 255, 0.35);
    transition: text-shadow 0.3s ease, border-color 0.3s ease;
  }
  .cmail-alt .cmail:hover {
    text-shadow: 0 0 14px rgba(74, 234, 255, 0.5);
    border-color: rgba(74, 234, 255, 0.7);
  }

  /* reduced motion: no lightning, no flicker; she simply rests in the sky.
     global.css already stops every animation, so the corner stars and the
     constellation lines hold as static dots and traces. */
  @media (prefers-reduced-motion: reduce) {
    .presence-img { opacity: 0.2; }
    .presence-glow, .presence-bolt { display: none; }
  }
</style>

<script>
  // ---------- cosmic thunder + constellation gating ----------
  // A soft flash every 9 to 16 seconds: ease her up to 0.55 with the glow
  // over ~150-200ms, hold ~80ms, ease back down over ~1-1.4s, sometimes with
  // one gentle secondary flicker on the way down. Opacity only, gated to the
  // section being in view and the tab visible. Never under reduced motion.
  // The same observer toggles .lit on the shell so the corner-star twinkle
  // runs only while the section is on screen.
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const shell = document.getElementById('contact');
  const img = document.querySelector('.presence-img') as HTMLElement | null;
  const glow = document.querySelector('.presence-glow') as HTMLElement | null;
  const bolts = Array.from(document.querySelectorAll('.presence-bolt')) as HTMLElement[];

  if (!reduce && shell && img && glow && 'IntersectionObserver' in window) {
    let inView = false;
    let timer = 0;

    const schedule = () => {
      window.clearTimeout(timer);
      timer = window.setTimeout(flash, 9000 + Math.random() * 7000);
    };

    function flash() {
      if (!inView || document.hidden) return; // re-armed when we come back
      const attack = 150 + Math.random() * 50;
      const hold = 80;
      const decay = 1000 + Math.random() * 400;
      const total = attack + hold + decay;
      const at = (t: number) => Math.min(t / total, 1);
      const flicker = Math.random() < 0.5;

      // she emerges from the dark on the lightning, then fades
      const imgFrames: Keyframe[] = [
        { opacity: 0.2, easing: 'ease-out' },
        { opacity: 0.55, offset: at(attack), easing: 'linear' },
        { opacity: 0.55, offset: at(attack + hold), easing: 'ease-in-out' },
      ];
      if (flicker) {
        imgFrames.push(
          { opacity: 0.32, offset: at(attack + hold + decay * 0.4), easing: 'ease-in-out' },
          { opacity: 0.4, offset: at(attack + hold + decay * 0.55), easing: 'ease-out' }
        );
      }
      imgFrames.push({ opacity: 0.2 });
      img.animate(imgFrames, { duration: total });

      glow.animate(
        [
          { opacity: 0, easing: 'ease-out' },
          { opacity: 0.55, offset: at(attack), easing: 'linear' },
          { opacity: 0.55, offset: at(attack + hold), easing: 'ease-out' },
          { opacity: 0 },
        ],
        { duration: total }
      );

      // one streak per flash, fading a little faster than she does
      const bolt = bolts[(Math.random() * bolts.length) | 0];
      bolt?.animate(
        [
          { opacity: 0, easing: 'ease-out' },
          { opacity: 0.5, offset: at(attack), easing: 'linear' },
          { opacity: 0.5, offset: at(attack + hold), easing: 'ease-out' },
          { opacity: 0, offset: Math.min(at(attack + hold + decay * 0.6), 1) },
          { opacity: 0 },
        ],
        { duration: total }
      );

      schedule();
    }

    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          inView = e.isIntersecting;
          shell.classList.toggle('lit', inView);
          if (inView && !document.hidden) schedule();
          else window.clearTimeout(timer);
        }
      },
      { threshold: 0.15 }
    );
    io.observe(shell);

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) window.clearTimeout(timer);
      else if (inView) schedule();
    });
  }
</script>
