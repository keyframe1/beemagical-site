---
/**
 * Hero.astro - the wordmark and the two calls to action. The wordmark
 * carries the tagline; no subhead. The bee is the persistent FaeBee island,
 * which lands here after the loader.
 */
---

<header class="hero" id="top">
  <div class="logo-stage">
    <img
      class="wordmark"
      src="/logo/bee-magical-wordmark.png"
      alt="Bee Magical"
      width="1030"
      height="242"
      fetchpriority="high"
    />
  </div>
  <div class="cta">
    <a class="btn" href="#gallery">Enter the gallery</a>
    <a class="btn ghost" href="#featured">Originals and prints</a>
  </div>
</header>

<style>
  .hero {
    min-height: 82vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 30px 24px 24px;
    position: relative;
  }
  .logo-stage { position: relative; width: min(620px, 90vw); margin-bottom: var(--space-2); }
  .wordmark { width: 100%; height: auto; display: block; filter: drop-shadow(0 0 30px rgba(217, 70, 239, 0.35)); }

  .cta { margin-top: var(--space-4); display: flex; gap: 14px; justify-content: center; flex-wrap: wrap; }
</style>
