---
/**
 * Featured.astro - the headline work. Pulls the featured piece from the
 * collection and renders it large inside a slow prismatic rim glow in the
 * brand colors. Clicking the image opens it in the Lightbox.
 *
 * The calls to action come from ctasFor (lib/art.ts), the same helper the
 * Lightbox uses, so the spotlight and the viewer always offer this piece the
 * same thing: a link straight to its own listing when one exists, and the
 * commission link beside it. Whatever the featured piece happens to be, it
 * inherits that logic rather than hardcoding a destination. No price here; the
 * Ko-fi listing quotes it.
 */
import { Image } from 'astro:assets';
import { getArt, FEATURED_SLUG, ctasFor } from '../lib/art';

const works = await getArt();
const index = works.findIndex((w) => w.id === FEATURED_SLUG);
const work = works[index];
const d = work.data;
const subLine = [d.medium, d.dimensions, d.year].filter(Boolean).join(' . ');
const { buy, commission } = ctasFor(d);
---

<section id="featured" class="section">
  <div class="reveal">
    <div class="eyebrow">Featured Work</div>
    <h2 class="section-title featured-title">{d.title}</h2>
  </div>

  <div class="feat reveal">
    <div class="feat-frame">
      <button class="feat-img" type="button" data-index={index} aria-label={`Open ${d.title} in the viewer`}>
        <Image
          src={d.image}
          alt={`${d.title}. ${d.note}`}
          widths={[400, 580, 768, 1160]}
          sizes="(max-width: 760px) 92vw, 580px"
          quality={90}
          format="webp"
          loading="lazy"
        />
      </button>
    </div>

    <div class="feat-body">
      <p class="feat-sub">{subLine}</p>
      <p class="feat-note">{d.note}</p>
      <div class="cta">
        {buy && (
          <a class="btn" href={buy.href} target="_blank" rel="noopener noreferrer" aria-label={buy.aria}>
            {buy.label}
          </a>
        )}
        <a
          class:list={['btn', buy && 'ghost']}
          href={commission.href}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={commission.aria}
        >
          {commission.label}
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .feat {
    display: grid;
    grid-template-columns: 1.35fr 1fr;
    gap: 48px;
    align-items: center;
    margin-top: var(--space-4);
  }

  /* prismatic rim: an oversized conic gradient rotates slowly behind the
     frame, blurred and at low opacity, clipped to a soft halo */
  .feat-frame { position: relative; }
  .feat-frame::before {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: 145%;
    aspect-ratio: 1;
    transform: translate(-50%, -50%);
    background: conic-gradient(
      var(--cyan),
      var(--purple),
      var(--magenta),
      var(--gold),
      var(--cyan)
    );
    border-radius: 50%;
    filter: blur(46px);
    opacity: 0.16;
    animation: prism 18s linear infinite;
    pointer-events: none;
    z-index: 0;
  }

  .feat-img {
    position: relative;
    z-index: 1;
    display: block;
    width: 100%;
    padding: 0;
    border: 1px solid rgba(74, 234, 255, 0.3);
    border-radius: var(--radius-md);
    overflow: hidden;
    cursor: pointer;
    background: #05071a;
    box-shadow: var(--glow-cyan), var(--shadow-card);
    transition: transform 0.4s ease, box-shadow 0.4s ease;
  }
  .feat-img:hover, .feat-img:focus-visible { transform: translateY(-4px); box-shadow: var(--glow-magenta), 0 22px 50px rgba(0, 0, 0, 0.6); }
  .feat-img :global(img) { width: 100%; height: auto; display: block; }

  .feat-sub { font-family: var(--font-body); font-weight: 300; font-size: 13px; letter-spacing: 0.06em; color: rgba(226, 232, 244, 0.55); }
  .feat-note { font-family: var(--font-body); font-weight: 300; font-size: clamp(17px, 2vw, 20px); color: rgba(226, 232, 244, 0.85); margin-top: 14px; }
  .cta { margin-top: 26px; display: flex; gap: 14px; flex-wrap: wrap; }

  .eyebrow {
    font-family: var(--font-body);
    font-weight: 500;
    font-size: 10px;
    letter-spacing: 0.4em;
    text-transform: uppercase;
    color: rgba(74, 234, 255, 0.65);
    text-align: center;
    margin-bottom: 12px;
  }

  @media (max-width: 760px) {
    .feat { grid-template-columns: 1fr; gap: 24px; }
    .feat-frame::before { display: none; } /* skip the heavy blur on small screens */
  }
</style>

<script>
  const fb = document.querySelector('.feat-img') as HTMLElement | null;
  fb?.addEventListener('click', () => {
    const r = fb.getBoundingClientRect();
    window.dispatchEvent(
      new CustomEvent('lightbox:open', {
        detail: { index: Number(fb.dataset.index), originX: r.left + r.width / 2, originY: r.top + r.height / 2 },
      })
    );
  });
</script>
