---
/**
 * FaeBee.astro - the persistent flying bee island, rigged in two layers:
 * a wings image flapping behind a static body image (same 306x277 canvas).
 *
 * Layer stack (outer to inner):
 *   #fae-bee     fixed position, translate3d flight path
 *   .bee-roll    barrel rolls (rotateY) and the landing squash, WAAPI
 *   .bee-inner   per-frame bank (rotateZ) + gentle bob
 *   .bee-wings   continuous CSS flap, origin at the wing root,
 *                motion-blurred during fast flight
 *   .bee-body    static art, never restyled
 *
 * Lifecycle:
 *  1. intro  - flies an arc in over the loader, decelerates, lands by the
 *              wordmark with a brief squash, fires a sparkle burst, then
 *              fades the loader away.
 *  2. idle   - hovers by the wordmark at a slow flap until the page scrolls.
 *  3. wander - vertical position tracks scroll progress, horizontal sine
 *              drift, banks into the turns. Occasional barrel rolls: on a
 *              12-20s timer, on sharp direction changes, and on section
 *              boundaries (cooldown guarded).
 *  4. guide  - when the constellation is in view it slows to a calm flap
 *              and traces the nodes, then lifts off and resumes wandering.
 *  5. perch  - alights on any point marked data-bee-perch as it drifts past,
 *              holds a beat, then lifts off. Desktop only, once per visit.
 *
 * Continuously emits cyan + gold sparkles and slower, larger fae-dust motes
 * that drift down behind it. Transform/opacity only, rAF throttled, paused
 * while the tab is hidden. On small screens the path simplifies to a high
 * band above the content and trails are reduced.
 * Under prefers-reduced-motion it parks quietly by the wordmark, wings still.
 */
---

<div id="fae-bee" aria-hidden="true">
  <div class="bee-roll">
    <div class="bee-inner">
      <img
        class="bee-wings"
        src="/logo/bee-magical-bee-wings.png"
        alt=""
        width="306"
        height="277"
        draggable="false"
      />
      <img
        class="bee-body"
        src="/logo/bee-magical-bee-body.png"
        alt=""
        width="306"
        height="277"
        draggable="false"
      />
    </div>
  </div>
</div>
<div class="bee-trail" aria-hidden="true"></div>

<style>
  #fae-bee {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 70;
    width: var(--bee-w, 88px);
    aspect-ratio: 306 / 277;
    pointer-events: none;
    will-change: transform;
    /* start parked off-screen until the island takes over */
    transform: translate3d(-200px, -200px, 0);
  }
  .bee-roll { position: absolute; inset: 0; will-change: transform; }
  .bee-inner { position: absolute; inset: 0; will-change: transform; }

  .bee-wings,
  .bee-body {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .bee-body { filter: drop-shadow(0 0 14px rgba(74, 234, 255, 0.5)); }
  .bee-wings {
    /* wing root: where the wings meet the back of the body */
    transform-origin: 55% 62%;
    will-change: transform;
    animation: beeflap var(--flap, 0.11s) ease-in-out infinite;
    transition: filter 0.25s ease;
  }
  /* a touch of motion blur on the wings during fast flight */
  #fae-bee.fast .bee-wings { filter: blur(1.5px); }
  #fae-bee.still .bee-wings { animation: none; }

  .bee-trail { position: fixed; inset: 0; z-index: 69; pointer-events: none; overflow: hidden; }
  :global(.bee-spark) { position: absolute; border-radius: 50%; will-change: transform, opacity; }
  :global(.bee-burst) {
    position: absolute;
    width: 70px; height: 70px;
    border-radius: 50%;
    border: 2px solid var(--cyan);
    box-shadow: 0 0 22px var(--cyan);
    transform: translate(-50%, -50%);
    will-change: transform, opacity;
  }

  @media (max-width: 640px) { #fae-bee { --bee-w: 60px; } }

  /* reduced-motion park: sit quietly near the hero, wings still */
  @media (prefers-reduced-motion: reduce) {
    .bee-wings { animation: none !important; }
  }
</style>

<script>
  const bee = document.getElementById('fae-bee') as HTMLElement | null;
  const roll = bee?.querySelector('.bee-roll') as HTMLElement | null;
  const inner = bee?.querySelector('.bee-inner') as HTMLElement | null;
  const trail = document.querySelector('.bee-trail') as HTMLElement | null;
  const loader = document.getElementById('loader');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const smallScreen = window.matchMedia('(max-width: 640px)');

  function finishLoader() {
    loader?.classList.add('done');
    document.body.classList.add('loaded');
  }

  if (!bee || !roll || !inner) {
    finishLoader();
  } else if (reduce) {
    // Park quietly near the wordmark, reveal everything, wings still, no trails.
    bee.classList.add('still');
    const px = window.innerWidth * 0.6;
    const py = window.innerHeight * 0.34;
    bee.style.transform = `translate3d(${px}px, ${py}px, 0)`;
    finishLoader();
  } else {
    const beeW = () => bee.offsetWidth || 88;
    const halfW = () => beeW() / 2;
    const halfH = () => (beeW() * (277 / 306)) / 2;

    // current + smoothed state
    let curX = -160, curY = window.innerHeight * 0.5;
    let prevX = curX, prevY = curY;
    let bank = 0;
    let vxSmooth = 0;

    // intro arc
    let introStart = performance.now();
    const introDur = 2200;
    const startX = -160;
    const startY = window.innerHeight * 0.78;
    let landX = window.innerWidth * 0.6;
    let landY = window.innerHeight * 0.36;
    // bezier control for the arc (sweeps up and over)
    let ctrlX = window.innerWidth * 0.32;
    let ctrlY = window.innerHeight * 0.12;

    let mode: 'intro' | 'idle' | 'wander' | 'guide' | 'perch' = 'intro';
    let burstFired = false;
    let idleStart = 0;
    let idleScrollY = 0;

    function recomputeLanding() {
      landX = window.innerWidth * 0.6;
      landY = window.innerHeight * 0.36;
      ctrlX = window.innerWidth * 0.32;
      ctrlY = window.innerHeight * 0.12;
    }
    window.addEventListener('resize', recomputeLanding);

    function easeOutCubic(t: number) { return 1 - Math.pow(1 - t, 3); }
    function bezier(p: number, a: number, c: number, b: number) {
      const m = 1 - p;
      return m * m * a + 2 * m * p * c + p * p * b;
    }

    // ---------- wing flap states ----------
    // beat duration: ~90-130ms in flight, calm when idling or guiding
    let flapState = '';
    function setFlap(state: 'fast' | 'cruise' | 'calm') {
      if (state === flapState) return;
      flapState = state;
      const dur = state === 'fast' ? '0.09s' : state === 'cruise' ? '0.12s' : '0.2s';
      bee!.style.setProperty('--flap', dur);
      bee!.classList.toggle('fast', state === 'fast');
    }
    setFlap('cruise');

    // ---------- barrel rolls ----------
    let rolling = false;
    let lastRoll = performance.now();
    let nextTimedRoll = performance.now() + 12000 + Math.random() * 8000;

    function barrelRoll(now: number) {
      if (rolling || now - lastRoll < 6000) return;
      rolling = true;
      lastRoll = now;
      nextTimedRoll = now + 12000 + Math.random() * 8000;
      const dir = vxSmooth >= 0 ? 1 : -1;
      roll!.animate(
        [
          { transform: 'perspective(600px) rotateY(0deg) rotateZ(0deg)' },
          { transform: `perspective(600px) rotateY(${dir * 200}deg) rotateZ(${dir * 10}deg)`, offset: 0.55 },
          { transform: `perspective(600px) rotateY(${dir * 360}deg) rotateZ(0deg)` },
        ],
        { duration: 700, easing: 'cubic-bezier(0.45, 0.1, 0.3, 1)' }
      ).onfinish = () => { rolling = false; };
    }

    // section boundaries: roll when the bee crosses into a new section
    const sectionEls = Array.from(document.querySelectorAll('main .section')) as HTMLElement[];
    let lastSection = -1;
    function sectionAt(scrollMid: number) {
      let idx = -1;
      for (let i = 0; i < sectionEls.length; i++) {
        if (sectionEls[i].offsetTop <= scrollMid) idx = i;
      }
      return idx;
    }

    // ---------- constellation guide wiring ----------
    let galleryInView = false;
    let guidedThisVisit = false;
    let guideNodes: HTMLElement[] = [];
    let guideIdx = 0;
    // lift-off impulse after finishing the trace, decays each frame
    let liftY = 0;

    const section = document.getElementById('gallery');
    if (section) {
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            galleryInView = e.isIntersecting && e.intersectionRatio > 0.35;
            if (!galleryInView) { guidedThisVisit = false; }
          }
        },
        { threshold: [0, 0.35, 0.6] }
      );
      io.observe(section);
    }

    function refreshGuideNodes() {
      guideNodes = (Array.from(document.querySelectorAll('.constellation .c-node')) as HTMLElement[])
        .filter((n) => n.offsetParent !== null);
    }

    // ---------- perch wiring ----------
    // The bee may alight on any point marked data-bee-perch as it drifts past:
    // the testimonial's top-right corner star, the contact constellation's
    // bright node. Once per visit each, desktop only, and only while that
    // point's frame (data-bee-perch-frame) is in view with the tab visible (the
    // loop already pauses when hidden). Cheap: it reuses the same
    // steer-and-settle motion the constellation guide uses. data-perch-lift
    // says how far above the point to settle, in half bee-heights, so the bee
    // reads as perched on it rather than sitting on top of what is underneath.
    type Perch = { star: HTMLElement; lift: number; inView: boolean; done: boolean };
    const perches: Perch[] = (
      Array.from(document.querySelectorAll('[data-bee-perch]')) as HTMLElement[]
    ).map((star) => {
      const p: Perch = {
        star,
        lift: Number(star.dataset.perchLift) || 1.05,
        inView: false,
        done: false,
      };
      const frame = (star.closest('[data-bee-perch-frame]') as HTMLElement | null) || star;
      new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            p.inView = e.isIntersecting && e.intersectionRatio > 0.4;
            if (!p.inView) p.done = false; // re-arm when it leaves view
          }
        },
        { threshold: [0, 0.4, 0.8] }
      ).observe(frame);
      return p;
    });
    let perch: Perch | null = null;
    let perchHoldUntil = 0;
    const openPerch = () => perches.find((p) => p.inView && !p.done) || null;

    // ---------- trail emission ----------
    let lastEmit = 0;
    let liveSparks = 0;
    const SPARK_CAP = 60;
    const sparkCols = ['#4AEAFF', '#E9C46A'];
    function emit(now: number, cx: number, cy: number) {
      if (!trail || document.hidden) return;
      const small = smallScreen.matches;
      const interval = small ? 110 : 55;
      if (now - lastEmit < interval || liveSparks >= SPARK_CAP) return;
      lastEmit = now;
      // small cyan/gold sparkles
      const n = small ? 1 : 1 + ((Math.random() * 2) | 0);
      for (let i = 0; i < n; i++) {
        const s = document.createElement('div');
        s.className = 'bee-spark';
        const col = sparkCols[(Math.random() * sparkCols.length) | 0];
        const size = 2.5 + Math.random() * 3.5;
        s.style.width = size + 'px';
        s.style.height = size + 'px';
        s.style.background = col;
        s.style.boxShadow = `0 0 8px ${col}`;
        s.style.left = cx + (Math.random() * 16 - 8) + 'px';
        s.style.top = cy + (Math.random() * 16 - 8) + 'px';
        trail.appendChild(s);
        liveSparks++;
        s.animate(
          [
            { transform: 'translateY(0) scale(1)', opacity: 0.95 },
            { transform: `translateY(${14 + Math.random() * 18}px) scale(0)`, opacity: 0 },
          ],
          { duration: 700 + Math.random() * 400, easing: 'ease-out' }
        ).onfinish = () => { s.remove(); liveSparks--; };
      }
      // occasional slower, larger fae-dust mote
      if (Math.random() > (small ? 0.85 : 0.7)) {
        const m = document.createElement('div');
        m.className = 'bee-spark';
        const col = Math.random() > 0.5 ? '#F0EAD6' : '#9B30FF';
        const size = 5 + Math.random() * 5;
        m.style.width = size + 'px';
        m.style.height = size + 'px';
        m.style.background = col;
        m.style.boxShadow = `0 0 10px ${col}`;
        m.style.left = cx + (Math.random() * 14 - 7) + 'px';
        m.style.top = cy + (Math.random() * 14 - 7) + 'px';
        trail.appendChild(m);
        liveSparks++;
        m.animate(
          [
            { transform: 'translateY(0) scale(1)', opacity: 0.7 },
            { transform: `translateY(${30 + Math.random() * 26}px) scale(0.4)`, opacity: 0 },
          ],
          { duration: 1500 + Math.random() * 700, easing: 'ease-out' }
        ).onfinish = () => { m.remove(); liveSparks--; };
      }
    }

    function fireBurst(cx: number, cy: number) {
      if (!trail) return;
      const b = document.createElement('div');
      b.className = 'bee-burst';
      b.style.left = cx + 'px';
      b.style.top = cy + 'px';
      trail.appendChild(b);
      b.animate(
        [
          { transform: 'translate(-50%,-50%) scale(0.2)', opacity: 0.9 },
          { transform: 'translate(-50%,-50%) scale(2.6)', opacity: 0 },
        ],
        { duration: 700, easing: 'ease-out' }
      ).onfinish = () => b.remove();
    }

    function land() {
      // decelerate is built into the eased arc; squash and settle here
      roll!.animate(
        [
          { transform: 'scaleY(1)' },
          { transform: 'scaleY(0.9) scaleX(1.05)', offset: 0.4 },
          { transform: 'scaleY(1)' },
        ],
        { duration: 420, easing: 'ease-out' }
      );
      fireBurst(curX + halfW(), curY + halfH());
      setTimeout(finishLoader, 180);
      setFlap('calm');
      mode = 'idle';
      idleStart = performance.now();
      idleScrollY = window.scrollY;
    }

    // ---------- main loop ----------
    let rafId = 0;
    function frame(now: number) {
      rafId = requestAnimationFrame(frame);
      let targetX: number, targetY: number;

      if (mode === 'intro') {
        const p = Math.min(1, (now - introStart) / introDur);
        const e = easeOutCubic(p);
        curX = bezier(e, startX, ctrlX, landX);
        curY = bezier(e, startY, ctrlY, landY);
        if (p > 0.75) setFlap('calm'); // ease off the wings on approach
        else setFlap('fast');
        if (p >= 1 && !burstFired) {
          burstFired = true;
          land();
        }
      } else if (mode === 'idle') {
        // hover by the wordmark: slow flap, gentle drift, until the page moves
        curX += (landX - curX) * 0.04 + Math.sin(now / 900) * 0.18;
        curY += (landY - curY) * 0.04 + Math.sin(now / 1300) * 0.22;
        if (Math.abs(window.scrollY - idleScrollY) > 30 && now - idleStart > 600) {
          mode = 'wander';
          setFlap('cruise');
        }
      } else {
        if (galleryInView && !guidedThisVisit && !smallScreen.matches) {
          if (mode !== 'guide') {
            mode = 'guide';
            refreshGuideNodes();
            guideIdx = 0;
            setFlap('calm');
            barrelRoll(now); // playful flip as it dives in to guide
          }
        }

        // enter the perch when a marked point drifts into view: once per visit,
        // desktop only, and only from a plain wander (never mid-guide)
        if (mode === 'wander' && !smallScreen.matches) {
          const open = openPerch();
          if (open) {
            perch = open;
            mode = 'perch';
            setFlap('calm');
          }
        }
        const wantPerch = mode === 'perch' && !!perch && perch.inView && !perch.done;

        if (mode === 'guide' && guideNodes.length) {
          const node = guideNodes[guideIdx];
          const r = node.getBoundingClientRect();
          targetX = r.left + r.width / 2 - halfW();
          targetY = r.top + r.height / 2 - halfH();
          const dx = targetX - curX, dy = targetY - curY;
          if (Math.hypot(dx, dy) < 26) {
            guideIdx++;
            if (guideIdx >= guideNodes.length) {
              // lift off: upward impulse, back to cruising
              guidedThisVisit = true;
              mode = 'wander';
              liftY = -90;
              setFlap('fast');
            }
          }
          curX += dx * 0.05;
          curY += dy * 0.05;
        } else if (wantPerch) {
          // steer to the star and settle just above it, so the bee reads as
          // perched on the point; hold a beat, then lift off and drift on
          const p = perch!;
          const r = p.star.getBoundingClientRect();
          targetX = r.left + r.width / 2 - halfW();
          targetY = r.top + r.height / 2 - halfH() * p.lift;
          const dx = targetX - curX, dy = targetY - curY;
          if (Math.hypot(dx, dy) < 16) {
            if (!perchHoldUntil) perchHoldUntil = now + 2400;
            else if (now >= perchHoldUntil) {
              perchHoldUntil = 0;
              p.done = true;
              perch = null;
              mode = 'wander';
              liftY = -70;
              setFlap('cruise');
            }
          }
          curX += dx * 0.07;
          curY += dy * 0.07;
        } else {
          // an interrupted perch (the frame scrolled away) drops cleanly back
          // to wandering rather than chasing an off-screen star
          if (mode === 'perch') { perchHoldUntil = 0; perch = null; setFlap('cruise'); }
          mode = galleryInView && !guidedThisVisit && !smallScreen.matches ? 'guide' : 'wander';
          // wander: vertical tracks scroll, horizontal sine drift
          const doc = document.documentElement;
          const max = (doc.scrollHeight - window.innerHeight) || 1;
          const frac = Math.min(1, Math.max(0, window.scrollY / max));
          if (smallScreen.matches) {
            // small screens: simplified path in a high band above the content
            const amp = window.innerWidth * 0.34;
            targetY = window.innerHeight * 0.09 + Math.sin(now / 1700) * 12 - halfH();
            targetX = window.innerWidth * 0.5 - halfW() + Math.sin(now / 2100 + frac * 4.0) * amp;
          } else {
            const amp = Math.min(window.innerWidth * 0.28, 260);
            targetY = window.innerHeight * (0.12 + frac * 0.7) - halfH();
            targetX =
              window.innerWidth * 0.5 - halfW() +
              Math.sin(now / 1400 + frac * 6.0) * amp +
              Math.sin(now / 3700) * (amp * 0.25);
          }
          liftY *= 0.94;
          curX += (targetX - curX) * 0.045;
          curY += (targetY + liftY - curY) * 0.06;

          // timed barrel roll while cruising
          if (now > nextTimedRoll) barrelRoll(now);
        }
      }

      // velocity: banking, flap speed, sharp-turn rolls
      const vx = curX - prevX;
      const vy = curY - prevY;
      prevX = curX;
      prevY = curY;
      const speed = Math.hypot(vx, vy);
      const prevVxSmooth = vxSmooth;
      vxSmooth += (vx - vxSmooth) * 0.08;

      if (mode === 'wander') {
        setFlap(speed > 5 ? 'fast' : 'cruise');
        // sharp direction change: flip the other way with a roll
        if (
          Math.sign(vxSmooth) !== Math.sign(prevVxSmooth) &&
          Math.abs(prevVxSmooth) > 2.2 &&
          Math.random() > 0.5
        ) {
          barrelRoll(now);
        }
        // crossing a section boundary
        const sec = sectionAt(window.scrollY + window.innerHeight * 0.5);
        if (sec !== lastSection) {
          if (lastSection !== -1 && Math.random() > 0.4) barrelRoll(now);
          lastSection = sec;
        }
      }

      const targetBank = Math.max(-18, Math.min(18, vx * 0.9));
      bank += (targetBank - bank) * 0.1;
      const bob = Math.sin(now / 460) * 2.2;

      bee!.style.transform = `translate3d(${curX.toFixed(1)}px, ${curY.toFixed(1)}px, 0)`;
      inner!.style.transform = `rotate(${(6 + bank).toFixed(2)}deg) translateY(${bob.toFixed(1)}px)`;

      emit(now, curX + halfW(), curY + halfH());
    }
    rafId = requestAnimationFrame(frame);

    // pause the loop entirely while the tab is hidden
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) {
        cancelAnimationFrame(rafId);
      } else {
        // re-anchor timers so the intro/rolls don't all fire at once
        const now = performance.now();
        if (mode === 'intro') introStart = now - introDur; // just land
        nextTimedRoll = Math.max(nextTimedRoll, now + 4000);
        prevX = curX;
        prevY = curY;
        rafId = requestAnimationFrame(frame);
      }
    });
  }
</script>
