---
/**
 * Constellation.astro - the gallery charted in stars, split into two galaxies.
 *
 * The art collection is divided by its medium field: every "Digital painting"
 * forms the Digital galaxy, everything physical (acrylic, etc.) forms the
 * Acrylic galaxy. Correcting a piece's medium later automatically moves it to
 * the right galaxy, no code change. Each galaxy is its own constellation that
 * works exactly like the old single one: one node per work placed by its x/y
 * percent, joined by lines that draw in on scroll, hover lighting, the
 * lightbox, the signatures-visible peek, and the sold-piece treatment. The two
 * sit in the same celestial sky, stacked digital over acrylic, parted by a
 * branded cosmic divider (a soft nebula band with a drifting comet).
 *
 * The bee (FaeBee) reads every node across both galaxies, so it traces one
 * then drifts to the other. data-index stays the global gallery index so the
 * Lightbox prev/next still walks the whole collection in one order.
 *
 * On small screens each galaxy becomes a stacked card grid (no lines).
 * Adding a painting never touches this file.
 */
import { Image } from 'astro:assets';
import { getArt, FEATURED_SLUG } from '../lib/art';

const works = await getArt();
// Global gallery index: the Lightbox maps over getArt() in this same order,
// so every node/card carries its global index for prev/next to agree.
const globalIndex = new Map(works.map((w, i) => [w.id, i]));

type Work = (typeof works)[number];
type Line = { x1: number; y1: number; x2: number; y2: number; a: string; b: string };

// Digital vs physical, read straight off the medium field.
const isDigital = (medium: string) => medium.toLowerCase().includes('digital');

// Build the joining lines for one galaxy, de-duplicated by undirected pair and
// limited to links whose other end also lives in this galaxy, so each
// constellation closes on itself.
function buildLines(subset: Work[]): Line[] {
  const inSet = new Map(subset.map((w) => [w.id, w]));
  const lines: Line[] = [];
  const seen = new Set<string>();
  for (const w of subset) {
    for (const slug of w.data.links) {
      const o = inSet.get(slug);
      if (!o) continue;
      const key = [w.id, slug].sort().join('|');
      if (seen.has(key)) continue;
      seen.add(key);
      lines.push({ x1: w.data.x, y1: w.data.y, x2: o.data.x, y2: o.data.y, a: w.id, b: slug });
    }
  }
  return lines;
}

const digital = works.filter((w) => isDigital(w.data.medium));
const acrylic = works.filter((w) => !isDigital(w.data.medium));

const galaxies = [
  { key: 'digital', label: 'Digital', flourish: 'bee', works: digital, lines: buildLines(digital) },
  { key: 'acrylic', label: 'Acrylic', flourish: 'star', works: acrylic, lines: buildLines(acrylic) },
];
---

<section id="gallery" class="section">
  <div class="reveal">
    <h2 class="section-title">The Gallery</h2>
    <p class="section-desc">Two galaxies to explore. Which will you visit first?</p>
  </div>

  {galaxies.map((g, gi) => (
    <>
      {gi > 0 && (
        <div class="galaxy-divider reveal" role="presentation">
          <span class="gx-neb" aria-hidden="true"></span>
          <span class="gx-comet" aria-hidden="true"><span class="gx-comet-head"></span></span>
        </div>
      )}

      <div class:list={['galaxy', g.key]}>
        <h3 class="galaxy-title reveal">
          {g.flourish === 'bee' ? (
            <img class="gx-flourish bee" src="/logo/bee-magical-bee-body.png" alt="" width="28" height="25" aria-hidden="true" />
          ) : (
            <span class="gx-flourish star" aria-hidden="true"></span>
          )}
          <span>{g.label}</span>
        </h3>

        <div class="constellation reveal" role="group" aria-label={`${g.label} constellation`}>
          <svg class="lines" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
            {g.lines.map((l) => (
              <line class="base" x1={l.x1} y1={l.y1} x2={l.x2} y2={l.y2} pathLength="1" data-a={l.a} data-b={l.b} />
            ))}
            {g.lines.map((l) => (
              <line class="pulse" x1={l.x1} y1={l.y1} x2={l.x2} y2={l.y2} pathLength="1" data-a={l.a} data-b={l.b} />
            ))}
          </svg>

          {g.works.map((w) => (
            <button
              class:list={['c-node', { featured: w.id === FEATURED_SLUG, sold: w.data.status === 'sold' }]}
              style={`left:${w.data.x}%; top:${w.data.y}%`}
              data-index={globalIndex.get(w.id)}
              data-slug={w.id}
              type="button"
              aria-label={`Open ${w.data.title}, ${w.data.medium}`}
            >
              <span class="peek">
                <Image src={w.data.image} alt="" width={280} loading="lazy" />
                {w.data.status === 'sold' && <span class="sold-tag">Sold</span>}
              </span>
              <span class="dot"></span>
              <span class="label">{w.data.title}</span>
            </button>
          ))}
        </div>

        <!-- small screens: stacked cards instead of the chart. Each card reveals
             on its own (not the whole grid at once): the grid is far taller than the
             viewport, so a single reveal on the container never reaches the observer
             threshold early and the gallery reads as blank in portrait. -->
        <div class="c-cards" role="group" aria-label={`${g.label} works`}>
          {g.works.map((w) => (
            <button
              class:list={['c-card reveal', { sold: w.data.status === 'sold' }]}
              data-index={globalIndex.get(w.id)}
              type="button"
              aria-label={w.data.status === 'sold' ? `Open ${w.data.title}, ${w.data.medium}, sold` : `Open ${w.data.title}, ${w.data.medium}`}
            >
              <span class="cc-art">
                <Image src={w.data.image} alt={`${w.data.title}. ${w.data.note}`} width={640} loading="lazy" />
                {w.data.status === 'sold' && <span class="sold-tag">Sold</span>}
              </span>
              <span class="cc-body">
                <span class="cc-title">{w.data.title}</span>
                <span class="cc-sub">{w.data.medium}</span>
              </span>
            </button>
          ))}
        </div>
      </div>
    </>
  ))}
</section>

<style>
  /* ---------- galaxy framing ---------- */
  .galaxy { margin-top: var(--space-4); }

  .galaxy-title {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    font-family: var(--font-head);
    font-size: clamp(26px, 3.4vw, 40px);
    color: var(--moon);
    text-shadow: 0 0 18px rgba(74, 234, 255, 0.25);
  }
  .gx-flourish.bee {
    width: 28px;
    height: auto;
    filter: drop-shadow(0 0 10px rgba(74, 234, 255, 0.6));
  }
  .gx-flourish.star {
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: radial-gradient(circle, #fff 0%, var(--gold) 40%, transparent 72%);
    box-shadow: 0 0 12px var(--gold);
    animation: tw 3.2s ease-in-out infinite;
  }

  .constellation {
    position: relative;
    width: 100%;
    aspect-ratio: 3 / 2;
    max-height: 64vh;
    margin-top: var(--space-2);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: var(--radius-lg);
    background: radial-gradient(ellipse 70% 60% at 50% 45%, rgba(74, 234, 255, 0.05), transparent 70%);
  }
  /* the acrylic galaxy glows a touch warmer so the two read as distinct skies */
  .galaxy.acrylic .constellation {
    background: radial-gradient(ellipse 70% 60% at 50% 45%, rgba(233, 196, 106, 0.05), transparent 70%);
  }

  .lines {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .lines line.base {
    stroke: rgba(74, 234, 255, 0.45);
    stroke-width: 1px;
    vector-effect: non-scaling-stroke;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    filter: drop-shadow(0 0 3px rgba(74, 234, 255, 0.5));
    transition: stroke 0.3s ease, opacity 0.3s ease;
  }
  .constellation.drawn .lines line.base {
    transition: stroke-dashoffset 1.4s ease, stroke 0.3s ease, opacity 0.3s ease;
    stroke-dashoffset: 0;
  }
  /* pulse overlay: a short dash of light that travels hovered lines */
  .lines line.pulse {
    stroke: #fff;
    stroke-width: 2px;
    vector-effect: non-scaling-stroke;
    stroke-linecap: round;
    stroke-dasharray: 0.12 0.88;
    stroke-dashoffset: 1;
    opacity: 0;
    filter: drop-shadow(0 0 5px rgba(74, 234, 255, 0.9));
  }

  /* hover neighborhood: brighten the lit, dim the rest */
  .constellation.focused .lines line.base { opacity: 0.3; }
  .constellation.focused .lines line.base.lit {
    opacity: 1;
    stroke: rgba(74, 234, 255, 0.95);
  }
  .constellation.focused .lines line.pulse.lit {
    opacity: 0.9;
    animation: linepulse 1.3s linear infinite;
  }
  .constellation.focused .c-node { opacity: 0.45; }
  .constellation.focused .c-node.lit { opacity: 1; }

  .c-node {
    position: absolute;
    transform: translate(-50%, -50%);
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
    color: var(--moon);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    transition: opacity 0.3s ease;
  }
  .c-node .dot {
    width: 13px;
    height: 13px;
    border-radius: 50%;
    background: var(--cyan);
    box-shadow: 0 0 10px var(--cyan), 0 0 22px rgba(74, 234, 255, 0.6);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  .c-node .label {
    font-family: var(--font-head);
    font-size: clamp(13px, 1.5vw, 18px);
    color: rgba(240, 234, 214, 0.9);
    text-shadow: 0 0 12px rgba(0, 0, 0, 0.8);
    opacity: 0.85;
    white-space: nowrap;
    transition: opacity 0.3s ease, transform 0.3s ease;
  }

  /* hover preview: the work floats up above its star */
  .c-node .peek {
    position: absolute;
    bottom: calc(100% + 10px);
    left: 50%;
    width: clamp(110px, 14vw, 160px);
    transform: translateX(-50%) translateY(8px) scale(0.9);
    opacity: 0;
    pointer-events: none;
    border-radius: var(--radius-sm);
    overflow: hidden;
    border: 1px solid rgba(74, 234, 255, 0.4);
    box-shadow: var(--glow-cyan), var(--shadow-card);
    background: #05071a;
    transition: opacity 0.3s ease, transform 0.3s ease;
    z-index: 3;
  }
  .c-node .peek :global(img) { width: 100%; height: auto; display: block; }
  .c-node.lit .peek, .c-node:focus-visible .peek {
    opacity: 1;
    transform: translateX(-50%) translateY(0) scale(1);
  }

  /* a small celestial corner pill marking a piece as sold. It rides the
     work's image (peek preview here, the card thumbnail on small screens)
     and matches the magenta of the sold node dot. Static, no animation. */
  .sold-tag {
    position: absolute;
    top: 8px;
    left: 8px;
    z-index: 2;
    font-family: var(--font-body);
    font-weight: 500;
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--moon);
    background: rgba(217, 70, 239, 0.24);
    border: 1px solid rgba(217, 70, 239, 0.6);
    border-radius: var(--radius-pill);
    padding: 3px 10px;
    box-shadow: 0 0 14px rgba(217, 70, 239, 0.35);
    pointer-events: none;
  }

  .c-node.featured .dot {
    width: 20px;
    height: 20px;
    background: var(--gold);
    box-shadow: 0 0 14px var(--gold), 0 0 34px rgba(233, 196, 106, 0.7);
  }
  .c-node.sold .dot { background: var(--magenta); box-shadow: 0 0 10px var(--magenta), 0 0 22px rgba(217, 70, 239, 0.6); }
  .c-node.lit .dot, .c-node:hover .dot, .c-node:focus-visible .dot {
    transform: scale(1.5);
    box-shadow: 0 0 16px var(--cyan), 0 0 40px rgba(74, 234, 255, 0.9);
  }
  .c-node.featured.lit .dot, .c-node.featured:hover .dot {
    box-shadow: 0 0 18px var(--gold), 0 0 46px rgba(233, 196, 106, 0.9);
  }
  .c-node.lit .label, .c-node:hover .label, .c-node:focus-visible .label { opacity: 1; transform: translateY(2px); }

  /* hover star burst ring, appended by the island */
  :global(.node-burst) {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    border: 1.5px solid var(--cyan);
    box-shadow: 0 0 14px var(--cyan);
    transform: translate(-50%, -50%);
    pointer-events: none;
    will-change: transform, opacity;
  }

  /* ---------- the cosmic divider between the two galaxies ---------- */
  /* a soft nebula band with a comet drifting across it, parting the skies.
     transform/opacity only; both pause when the tab hides (global.css) and
     freeze under reduced motion. */
  .galaxy-divider {
    position: relative;
    height: 84px;
    margin: var(--space-3) 0;
    overflow: hidden;
    pointer-events: none;
  }
  .gx-neb {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 80%;
    height: 60px;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background:
      radial-gradient(ellipse 60% 70% at 35% 50%, rgba(155, 48, 255, 0.30), transparent 70%),
      radial-gradient(ellipse 55% 60% at 62% 50%, rgba(74, 234, 255, 0.22), transparent 70%),
      radial-gradient(ellipse 40% 55% at 50% 50%, rgba(217, 70, 239, 0.18), transparent 72%);
    filter: blur(14px);
    opacity: 0.7;
    animation: gxneb 9s ease-in-out infinite;
  }
  /* a thin star-line through the middle, the seam between galaxies */
  .galaxy-divider::after {
    content: '';
    position: absolute;
    left: 12%;
    right: 12%;
    top: 50%;
    height: 1px;
    transform: translateY(-50%);
    background: linear-gradient(90deg, transparent, rgba(74, 234, 255, 0.5), rgba(155, 48, 255, 0.5), transparent);
    opacity: 0.5;
  }
  .gx-comet {
    position: absolute;
    top: 38%;
    left: 0;
    width: 64px;
    height: 2px;
    transform: translateX(-120px);
    background: linear-gradient(90deg, transparent, rgba(240, 234, 214, 0.85));
    border-radius: 2px;
    opacity: 0;
    animation: gxcomet 11s linear infinite;
  }
  .gx-comet-head {
    position: absolute;
    right: -3px;
    top: 50%;
    width: 7px;
    height: 7px;
    transform: translateY(-50%);
    border-radius: 50%;
    background: radial-gradient(circle, #fff 0%, var(--cyan) 45%, transparent 75%);
    box-shadow: 0 0 12px var(--cyan), 0 0 22px rgba(74, 234, 255, 0.7);
  }

  @keyframes gxneb {
    0%, 100% { opacity: 0.55; transform: translate(-52%, -50%) scale(1); }
    50% { opacity: 0.8; transform: translate(-48%, -50%) scale(1.06); }
  }
  @keyframes gxcomet {
    0% { transform: translateX(-120px); opacity: 0; }
    8% { opacity: 1; }
    48% { opacity: 1; }
    58% { transform: translateX(105vw); opacity: 0; }
    100% { transform: translateX(105vw); opacity: 0; }
  }

  /* ---------- stacked card grid (small screens) ---------- */
  .c-cards { display: none; }

  @media (max-width: 640px) {
    .constellation { display: none; }
    .galaxy { margin-top: var(--space-3); }
    .galaxy-divider { height: 60px; }
    .c-cards {
      display: grid;
      grid-template-columns: 1fr;
      gap: var(--space-2);
      margin-top: var(--space-3);
    }
    .c-card {
      display: block;
      padding: 0;
      text-align: left;
      cursor: pointer;
      background: #05071a;
      border: 1px solid rgba(74, 234, 255, 0.25);
      border-radius: var(--radius-md);
      overflow: hidden;
      box-shadow: var(--shadow-card);
      color: var(--moon);
    }
    .c-card :global(img) { width: 100%; height: auto; display: block; }
    .cc-art { display: block; position: relative; }
    /* sold cards read as unavailable with a mild dim and desaturation that
       still lets the art show. On touch there is no hover, so the dim stays
       gentle; where hover or focus exists the piece returns to full vibrancy. */
    .c-card.sold .cc-art :global(img) {
      filter: saturate(0.72) brightness(0.84);
      transition: filter 0.4s ease;
    }
    .c-card.sold:hover .cc-art :global(img),
    .c-card.sold:focus-visible .cc-art :global(img) {
      filter: none;
    }
    .cc-body {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 10px;
      padding: 12px 16px 14px;
    }
    .cc-title { font-family: var(--font-head); font-size: 20px; color: var(--moon); }
    .cc-sub { font-family: var(--font-body); font-weight: 300; font-size: 11px; letter-spacing: 0.06em; color: rgba(226, 232, 244, 0.55); }
  }
</style>

<script>
  // Each galaxy is an independent constellation: wire draw-in and hover
  // lighting per map so the two skies light on their own.
  for (const map of Array.from(document.querySelectorAll('#gallery .constellation')) as HTMLElement[]) {
    // draw the lines in when this map scrolls into view
    const io = new IntersectionObserver(
      (entries, obs) => {
        for (const e of entries) {
          if (e.isIntersecting) { map.classList.add('drawn'); obs.disconnect(); }
        }
      },
      { threshold: 0.25 }
    );
    io.observe(map);

    // hover/focus neighborhood lighting + star burst, scoped to this map
    const allLines = Array.from(map.querySelectorAll('.lines line')) as unknown as SVGLineElement[];
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function light(node: HTMLElement) {
      const slug = node.dataset.slug;
      map.classList.add('focused');
      node.classList.add('lit');
      for (const l of allLines) {
        l.classList.toggle('lit', l.dataset.a === slug || l.dataset.b === slug);
      }
      if (!reduce) {
        const burst = document.createElement('span');
        burst.className = 'node-burst';
        node.appendChild(burst);
        burst.animate(
          [
            { transform: 'translate(-50%,-50%) scale(0.3)', opacity: 0.9 },
            { transform: 'translate(-50%,-50%) scale(2.1)', opacity: 0 },
          ],
          { duration: 600, easing: 'ease-out' }
        ).onfinish = () => burst.remove();
      }
    }
    function unlight(node: HTMLElement) {
      map.classList.remove('focused');
      node.classList.remove('lit');
      for (const l of allLines) l.classList.remove('lit');
    }

    for (const node of Array.from(map.querySelectorAll('.c-node')) as HTMLElement[]) {
      node.addEventListener('mouseenter', () => light(node));
      node.addEventListener('mouseleave', () => unlight(node));
      node.addEventListener('focus', () => light(node));
      node.addEventListener('blur', () => unlight(node));
    }
  }

  // open the lightbox on node or card click (delegated per container),
  // passing the click origin so the viewer can scale out from it
  for (const host of Array.from(document.querySelectorAll('#gallery .constellation, #gallery .c-cards'))) {
    host.addEventListener('click', (ev) => {
      const node = (ev.target as HTMLElement).closest('.c-node, .c-card') as HTMLElement | null;
      if (!node) return;
      const r = node.getBoundingClientRect();
      window.dispatchEvent(
        new CustomEvent('lightbox:open', {
          detail: { index: Number(node.dataset.index), originX: r.left + r.width / 2, originY: r.top + r.height / 2 },
        })
      );
    });
  }
</script>
