---
/**
 * Watch.astro - Hannah's YouTube, pulled at build time from the public RSS
 * feed (see lib/videos.ts). Each of the most recent videos renders as a
 * lightweight facade card in the celestial style: a rounded, soft-glow frame
 * with two corner star-dots, a lazy-loaded 16:9 thumbnail (maxres, falling
 * back to hq on error), a centered play overlay, and the title beneath.
 *
 * Nothing from YouTube loads on page view. Clicking a card opens an in-page
 * lightbox that injects a single youtube-nocookie embed iframe only on click;
 * closing removes it. Below the grid, a quiet link leads to the channel.
 *
 * Resilience: if the feed fetch fails or is empty at build time, the grid is
 * skipped and a single clean "Watch on YouTube" card links to the channel, so
 * the section always renders. No em dashes anywhere.
 *
 * Motion: the only animation here is the corner-star twinkle (the shared `tw`
 * keyframe, transform/opacity only). The client island just wires the facade
 * click-to-embed lightbox; it touches no animation and respects the page's
 * reduced-motion handling in global.css.
 */
import { getVideos, YT_CHANNEL } from '../lib/videos';

const videos = await getVideos(6);
const hasVideos = videos.length > 0;
---

<section id="watch" class="section">
  <div class="reveal">
    <h2 class="section-title">Watch</h2>
    <p class="section-desc">Time-lapses and process from the studio, over on YouTube.</p>
  </div>

  {hasVideos ? (
    <>
      <div class="watch-grid reveal">
        {videos.map((v) => (
          <button
            class="watch-card"
            type="button"
            data-video-id={v.id}
            data-video-title={v.title}
            aria-label={`Play video: ${v.title}`}
          >
            <span class="watch-frame">
              <span class="com-star tl" aria-hidden="true"></span>
              <span class="com-star br" aria-hidden="true"></span>
              <img
                class="watch-thumb"
                src={`https://i.ytimg.com/vi/${v.id}/maxresdefault.jpg`}
                alt=""
                width="1280"
                height="720"
                loading="lazy"
                decoding="async"
                onerror={`this.onerror=null;this.src='https://i.ytimg.com/vi/${v.id}/hqdefault.jpg';`}
              />
              <span class="watch-play" aria-hidden="true">
                <svg viewBox="0 0 68 48" width="68" height="48">
                  <path class="play-bg" d="M66.5 7.5c-.8-3-3-5.2-6-6C55.1.5 34 .5 34 .5S12.9.5 7.5 1.5c-3 .8-5.2 3-6 6C.5 12.9.5 24 .5 24s0 11.1 1 16.5c.8 3 3 5.2 6 6C12.9 47.5 34 47.5 34 47.5s21.1 0 26.5-1c3-.8 5.2-3 6-6 1-5.4 1-16.5 1-16.5s0-11.1-1-16.5z"/>
                  <path class="play-arrow" d="M27 34V14l18 10z"/>
                </svg>
              </span>
            </span>
            <span class="watch-cap">{v.title}</span>
          </button>
        ))}
      </div>

      <div class="watch-cta reveal">
        <a class="watch-all" href={YT_CHANNEL} target="_blank" rel="noopener noreferrer">View all on YouTube</a>
      </div>
    </>
  ) : (
    <div class="watch-grid watch-grid--fallback reveal">
      <a class="watch-card watch-card--fallback" href={YT_CHANNEL} target="_blank" rel="noopener noreferrer">
        <span class="watch-frame">
          <span class="com-star tl" aria-hidden="true"></span>
          <span class="com-star br" aria-hidden="true"></span>
          <span class="watch-fallback-inner">
            <span class="watch-play" aria-hidden="true">
              <svg viewBox="0 0 68 48" width="68" height="48">
                <path class="play-bg" d="M66.5 7.5c-.8-3-3-5.2-6-6C55.1.5 34 .5 34 .5S12.9.5 7.5 1.5c-3 .8-5.2 3-6 6C.5 12.9.5 24 .5 24s0 11.1 1 16.5c.8 3 3 5.2 6 6C12.9 47.5 34 47.5 34 47.5s21.1 0 26.5-1c3-.8 5.2-3 6-6 1-5.4 1-16.5 1-16.5s0-11.1-1-16.5z"/>
                <path class="play-arrow" d="M27 34V14l18 10z"/>
              </svg>
            </span>
          </span>
        </span>
        <span class="watch-cap">Watch on YouTube</span>
      </a>
    </div>
  )}
</section>

<!-- in-page video viewer; the iframe is injected only on click -->
<div id="watch-lightbox" class="wlb" role="dialog" aria-modal="true" aria-label="Video player" hidden>
  <button class="wlb-close" type="button" aria-label="Close video">&times;</button>
  <div class="wlb-stage">
    <div class="wlb-frame" id="watch-embed"></div>
  </div>
</div>

<style>
  .watch-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-3);
    margin-top: var(--space-4);
    align-items: start;
  }
  .watch-grid--fallback { max-width: 480px; margin-left: auto; margin-right: auto; }

  /* facade card: a bare button so the whole tile is the click target */
  .watch-card {
    display: flex;
    flex-direction: column;
    gap: 0;
    margin: 0;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    text-align: center;
    text-decoration: none;
    cursor: pointer;
    font: inherit;
  }

  /* same star-framed celestial panel as the commission cards, in 16:9 */
  .watch-frame {
    position: relative;
    display: block;
    border: 1px solid rgba(74, 234, 255, 0.3);
    border-radius: var(--radius-md);
    overflow: hidden;
    background: #05071a;
    box-shadow: var(--glow-cyan), var(--shadow-card);
    transition: transform 0.4s ease, box-shadow 0.4s ease;
  }
  .watch-card:hover .watch-frame,
  .watch-card:focus-visible .watch-frame {
    transform: translateY(-4px);
    box-shadow: var(--glow-magenta), 0 22px 50px rgba(0, 0, 0, 0.6);
  }

  .watch-thumb {
    width: 100%;
    aspect-ratio: 16 / 9;
    height: auto;
    object-fit: cover;
    display: block;
  }

  /* centered play button, lifts and glows with the card */
  .watch-play {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
  }
  .watch-play svg { filter: drop-shadow(0 4px 14px rgba(0, 0, 0, 0.6)); }
  .play-bg { fill: rgba(5, 7, 26, 0.6); transition: fill 0.3s ease; }
  .play-arrow { fill: var(--moon); }
  .watch-card:hover .play-bg,
  .watch-card:focus-visible .play-bg { fill: rgba(217, 70, 239, 0.85); }

  .watch-cap {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    padding: 12px 6px 0;
    font-family: var(--font-body);
    font-weight: 500;
    font-size: 14px;
    letter-spacing: 0.04em;
    line-height: 1.4;
    color: var(--moon);
  }

  /* the corner stars are shared with the commission frame */
  .com-star {
    position: absolute;
    z-index: 1;
    width: 10px;
    height: 10px;
    background: radial-gradient(circle, #fff 0%, rgba(74, 234, 255, 0.9) 35%, transparent 70%);
    pointer-events: none;
    animation: tw 3.2s ease-in-out infinite;
  }
  .com-star.tl { top: 8px; left: 8px; }
  .com-star.br { bottom: 8px; right: 8px; animation-delay: 1.4s; }

  /* fallback card: same frame, an empty 16:9 panel with the play mark */
  .watch-fallback-inner {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    background: radial-gradient(ellipse at center, rgba(74, 234, 255, 0.08), transparent 70%);
  }

  .watch-cta { margin-top: var(--space-4); text-align: center; }
  .watch-all {
    font-family: var(--font-body);
    font-weight: 500;
    font-size: 13px;
    letter-spacing: 0.12em;
    color: rgba(226, 232, 244, 0.6);
    text-decoration: none;
    transition: color 0.3s ease, text-shadow 0.3s ease;
  }
  .watch-all:hover { color: var(--cyan); text-shadow: 0 0 14px rgba(74, 234, 255, 0.5); }

  @media (max-width: 900px) {
    .watch-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 480px) {
    .watch-grid { grid-template-columns: 1fr; max-width: 360px; margin-left: auto; margin-right: auto; }
  }

  /* ---- the in-page video lightbox ---- */
  .wlb {
    position: fixed;
    inset: 0;
    z-index: 80;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 5vh 6vw;
    background: rgba(2, 3, 10, 0.92);
    backdrop-filter: blur(8px);
  }
  .wlb[hidden] { display: none; }

  .wlb-stage { width: min(1000px, 100%); }
  .wlb-frame {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-md);
    overflow: hidden;
    border: 1px solid rgba(74, 234, 255, 0.3);
    box-shadow: 0 0 38px rgba(74, 234, 255, 0.18), var(--shadow-deep);
    background: #05071a;
  }
  .wlb-frame :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }

  .wlb-close {
    position: absolute;
    top: 22px;
    right: 24px;
    z-index: 2;
    width: 46px;
    height: 46px;
    font-size: 26px;
    line-height: 1;
    background: rgba(74, 234, 255, 0.07);
    border: 1px solid rgba(74, 234, 255, 0.35);
    color: var(--moon);
    cursor: pointer;
    border-radius: var(--radius-pill);
    transition: background 0.25s ease, box-shadow 0.25s ease;
  }
  .wlb-close:hover { background: rgba(74, 234, 255, 0.2); box-shadow: 0 0 20px rgba(74, 234, 255, 0.35); }
</style>

<script>
  /**
   * Facade island: clicking a card injects a single youtube-nocookie embed
   * into the lightbox. No YouTube iframe exists until a card is clicked, and
   * closing removes it so playback stops and nothing keeps running offscreen.
   * Pure DOM wiring, no animation, transform/opacity untouched.
   */
  const lb = document.getElementById('watch-lightbox');
  const embed = document.getElementById('watch-embed');
  if (lb && embed) {
    const closeBtn = lb.querySelector('.wlb-close') as HTMLButtonElement;
    let lastFocus: HTMLElement | null = null;

    function openVideo(id: string, title: string) {
      lastFocus = document.activeElement as HTMLElement;
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1`;
      iframe.title = title || 'YouTube video player';
      iframe.allow =
        'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
      iframe.setAttribute('allowfullscreen', '');
      embed!.replaceChildren(iframe);
      lb!.hidden = false;
      document.body.style.overflow = 'hidden';
      closeBtn.focus();
    }

    function close() {
      lb!.hidden = true;
      embed!.replaceChildren(); // drop the iframe, stopping playback
      document.body.style.overflow = '';
      lastFocus?.focus();
    }

    for (const card of Array.from(
      document.querySelectorAll('#watch .watch-card[data-video-id]')
    ) as HTMLElement[]) {
      card.addEventListener('click', () =>
        openVideo(card.dataset.videoId!, card.dataset.videoTitle ?? '')
      );
    }

    closeBtn.addEventListener('click', close);
    lb.addEventListener('click', (e) => {
      if (e.target === lb) close();
    });
    document.addEventListener('keydown', (e) => {
      if (!lb!.hidden && e.key === 'Escape') close();
    });
  }
</script>
