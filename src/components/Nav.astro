---
/**
 * Nav.astro - static top bar. Wordmark on the left, section links and the
 * real external links on the right. External links open in a new tab.
 *
 * Contact is external too: there is no form to jump to, so the word people
 * reach for when they want to reach her leads straight to Ko-fi commissions
 * (lib/links.ts). The Contact section still closes the page with the same
 * invitation and her email underneath.
 */
import { KOFI_COMMISSIONS, KOFI_HOME } from '../lib/links';

const INSTAGRAM = 'https://www.instagram.com/bee__magical/';
const YOUTUBE = 'https://www.youtube.com/@beemagicalart';
---

<nav class="bar">
  <a class="mark-link" href="#top" aria-label="Bee Magical, home">
    <img class="mark" src="/logo/bee-magical-wordmark.png" alt="Bee Magical" width="1030" height="242" />
  </a>
  <div class="links">
    <a href="#gallery">Gallery</a>
    <a href="#featured">Featured</a>
    <a href="#commissions">Commissions</a>
    <a href="#stickers">Stickers</a>
    <a href={KOFI_COMMISSIONS} target="_blank" rel="noopener noreferrer">Contact</a>
    <a href={INSTAGRAM} target="_blank" rel="noopener">Instagram</a>
    <a href={YOUTUBE} target="_blank" rel="noopener noreferrer">YouTube</a>
    <a href={KOFI_HOME} target="_blank" rel="noopener">Ko-fi</a>
  </div>
</nav>

<style>
  nav.bar {
    position: sticky;
    top: 0;
    z-index: 40;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    /* horizontal padding clears the notch when the page runs edge to edge;
       top padding honors any top inset on notched phones */
    padding: max(10px, env(safe-area-inset-top)) max(36px, env(safe-area-inset-right)) 10px max(36px, env(safe-area-inset-left));
    background: linear-gradient(to bottom, rgba(3, 5, 14, 0.78), rgba(3, 5, 14, 0));
    backdrop-filter: blur(6px);
  }
  /* wordmark home link: padded to a 44px tap target */
  .mark-link { display: inline-flex; align-items: center; min-height: 44px; padding: 4px 0; }
  .mark {
    height: 34px;
    width: auto;
    filter: drop-shadow(0 0 14px rgba(217, 70, 239, 0.4));
  }
  /* links wrap rather than clip at large zoom / font sizes */
  .links { display: flex; gap: 8px 22px; align-items: center; flex-wrap: wrap; justify-content: flex-end; }
  .links a {
    font-family: var(--font-body);
    font-weight: 500;
    font-size: 13px;
    letter-spacing: 0.12em;
    color: rgba(226, 232, 244, 0.6);
    text-decoration: none;
    /* every link is a 44px-tall tap target with breathing room */
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    transition: color 0.3s ease, text-shadow 0.3s ease;
  }
  .links a:hover { color: var(--cyan); text-shadow: 0 0 14px rgba(74, 234, 255, 0.5); }

  @media (max-width: 760px) {
    nav.bar { padding-left: max(20px, env(safe-area-inset-left)); padding-right: max(20px, env(safe-area-inset-right)); }
    .links { gap: 6px 16px; }
    .links a:nth-child(2) { display: none; } /* hide Featured to save room */
  }
  @media (max-width: 560px) {
    .mark { height: 28px; }
    .links { gap: 4px 14px; }
    .links a { font-size: 11px; letter-spacing: 0.06em; }
    /* the external links also live in Contact and the footer */
    .links a:nth-child(6), .links a:nth-child(7), .links a:nth-child(8) { display: none; }
  }
</style>
