---
/**
 * Footer.astro - small bee-and-moon logo mark and text lockup, the real links,
 * and a quiet sign-off. No em dashes.
 */
const INSTAGRAM = 'https://www.instagram.com/bee__magical/';
const KOFI = 'https://ko-fi.com/bee_magical';
const YOUTUBE = 'https://www.youtube.com/@beemagicalart';
const year = 2026;
---

<footer class="foot">
  <div class="div"><span class="ln"></span><span class="d"></span><span class="ln"></span></div>
  <div class="lockup">
    <img class="fbee" src="/logo/bee-magical-bee-moon.png" alt="" width="512" height="512" />
    <img class="fmark" src="/logo/bee-magical-wordmark.png" alt="Bee Magical" width="1030" height="242" />
  </div>
  <p class="foffer">Originals, Prints, Commissions.</p>
  <div class="foot-links">
    <a href={INSTAGRAM} target="_blank" rel="noopener">Instagram</a>
    <span class="sep">.</span>
    <a href={YOUTUBE} target="_blank" rel="noopener noreferrer">YouTube</a>
    <span class="sep">.</span>
    <a href={KOFI} target="_blank" rel="noopener">Ko-fi</a>
  </div>
  <small>Made in Louisiana. &copy; {year} Bee Magical.</small>
</footer>

<style>
  .foot {
    text-align: center;
    padding: var(--space-4) max(var(--space-3), env(safe-area-inset-right)) calc(var(--space-5) + env(safe-area-inset-bottom)) max(var(--space-3), env(safe-area-inset-left));
    position: relative;
    z-index: 2;
  }

  .lockup {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-top: var(--space-3);
  }
  .fbee {
    width: 34px;
    height: auto;
    filter: drop-shadow(0 0 10px rgba(74, 234, 255, 0.45));
  }
  /* the brand name is the wordmark image, never typed */
  .fmark {
    height: 28px;
    width: auto;
    filter: drop-shadow(0 0 16px rgba(217, 70, 239, 0.4));
  }

  .foffer {
    margin-top: 6px;
    font-family: var(--font-body);
    font-weight: 300;
    font-size: 13px;
    letter-spacing: 0.14em;
    color: rgba(226, 232, 244, 0.6);
  }

  .foot-links {
    margin-top: var(--space-2);
    font-family: var(--font-body);
    font-weight: 500;
    letter-spacing: 0.1em;
    font-size: 13px;
    /* center the links and dots while each link is a full tap target */
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
  }
  .foot-links a {
    color: rgba(226, 232, 244, 0.7);
    text-decoration: none;
    /* 44px tap targets with spacing between them */
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 10px;
    transition: color 0.3s ease, text-shadow 0.3s ease;
  }
  .foot-links a:hover { color: var(--cyan); text-shadow: 0 0 14px rgba(74, 234, 255, 0.5); }
  .foot-links .sep { color: rgba(255, 255, 255, 0.3); }
  .foot small {
    display: block;
    font-family: var(--font-body);
    font-size: 11px;
    letter-spacing: 0.16em;
    color: rgba(255, 255, 255, 0.32);
    margin-top: var(--space-2);
  }
</style>
