---
/**
 * Footer.astro - small bee mark and text lockup, the real links, and a
 * quiet sign-off. No em dashes.
 */
const INSTAGRAM = 'https://www.instagram.com/bee__magical/';
const KOFI = 'https://ko-fi.com/bee_magical';
const YOUTUBE = 'https://www.youtube.com/@beemagicalart';
const year = 2026;
---

<footer class="foot">
  <div class="div"><span class="ln"></span><span class="d"></span><span class="ln"></span></div>
  <div class="lockup">
    <img class="fbee" src="/logo/bee-magical-bee.png" alt="" width="306" height="277" />
    <span class="fname">Bee Magical</span>
  </div>
  <p class="foffer">Originals, Prints, Commissions.</p>
  <div class="foot-links">
    <a href={INSTAGRAM} target="_blank" rel="noopener">Instagram</a>
    <span class="sep">.</span>
    <a href={YOUTUBE} target="_blank" rel="noopener noreferrer">YouTube</a>
    <span class="sep">.</span>
    <a href={KOFI} target="_blank" rel="noopener">Ko-fi</a>
  </div>
  <small>Made in Louisiana. &copy; {year} Bee Magical.</small>
</footer>

<style>
  .foot { text-align: center; padding: var(--space-4) var(--space-3) var(--space-5); position: relative; z-index: 2; }

  .lockup {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-top: var(--space-3);
  }
  .fbee {
    width: 34px;
    height: auto;
    filter: drop-shadow(0 0 10px rgba(74, 234, 255, 0.45));
  }
  .fname {
    font-family: var(--font-head);
    font-size: 24px;
    color: var(--moon);
    text-shadow: 0 0 18px rgba(217, 70, 239, 0.35);
  }

  .foffer {
    margin-top: 6px;
    font-family: var(--font-body);
    font-weight: 300;
    font-size: 13px;
    letter-spacing: 0.14em;
    color: rgba(226, 232, 244, 0.6);
  }

  .foot-links {
    margin-top: var(--space-2);
    font-family: var(--font-body);
    font-weight: 500;
    letter-spacing: 0.1em;
    font-size: 13px;
  }
  .foot-links a { color: rgba(226, 232, 244, 0.7); text-decoration: none; transition: color 0.3s ease, text-shadow 0.3s ease; }
  .foot-links a:hover { color: var(--cyan); text-shadow: 0 0 14px rgba(74, 234, 255, 0.5); }
  .foot-links .sep { color: rgba(255, 255, 255, 0.3); margin: 0 12px; }
  .foot small {
    display: block;
    font-family: var(--font-body);
    font-size: 11px;
    letter-spacing: 0.16em;
    color: rgba(255, 255, 255, 0.32);
    margin-top: var(--space-2);
  }
</style>
