---
/**
 * Footer.astro - wordmark, the real links, and a quiet sign-off.
 * No em dashes.
 */
const INSTAGRAM = 'https://www.instagram.com/bee__magical/';
const KOFI = 'https://ko-fi.com/bee_magical';
const year = 2026;
---

<footer class="foot">
  <div class="div"><span class="ln"></span><span class="d"></span><span class="ln"></span></div>
  <img class="fm" src="/logo/bee-magical-wordmark.png" alt="Bee Magical" width="1030" height="242" />
  <div class="foot-links">
    <a href={INSTAGRAM} target="_blank" rel="noopener">Instagram</a>
    <span class="sep">.</span>
    <a href={KOFI} target="_blank" rel="noopener">Ko-fi</a>
  </div>
  <small>Bright paintings against the dark. Made in Louisiana. &copy; {year} Bee Magical.</small>
</footer>

<style>
  .foot { text-align: center; padding: 60px 24px 90px; position: relative; z-index: 2; }
  .fm { height: 30px; width: auto; opacity: 0.85; margin: 22px auto 0; filter: drop-shadow(0 0 12px rgba(217, 70, 239, 0.4)); }
  .foot-links {
    margin-top: 18px;
    font-family: var(--font-body);
    font-weight: 500;
    letter-spacing: 0.1em;
    font-size: 13px;
  }
  .foot-links a { color: rgba(226, 232, 244, 0.7); text-decoration: none; transition: color 0.3s ease, text-shadow 0.3s ease; }
  .foot-links a:hover { color: var(--cyan); text-shadow: 0 0 14px rgba(74, 234, 255, 0.5); }
  .foot-links .sep { color: rgba(255, 255, 255, 0.3); margin: 0 12px; }
  .foot small {
    display: block;
    font-family: var(--font-body);
    font-size: 11px;
    letter-spacing: 0.16em;
    color: rgba(255, 255, 255, 0.32);
    margin-top: 16px;
  }
</style>
