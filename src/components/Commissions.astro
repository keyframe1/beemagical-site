---
/**
 * Commissions.astro - skill and process examples, not listings. Two portrait
 * time-lapses play inside star-framed cards on hover or when scrolled into
 * view, each posing on Hannah's finished painting as its poster frame (Mick
 * Jagger and a mustached portrait), and two pet portraits stand as stills (a
 * Boston Terrier and a cat). Below the grid, a process time-lapse sits as a
 * single centered portal in the same celestial frame. Every video is muted,
 * playsinline, preload="none" with its poster held until play, and they share
 * one exclusive group so at most one plays at a time: only the clip in view
 * runs, the rest pause offscreen or when the tab hides. Captions name only
 * the piece type. One button leads to the contact section. No prices anywhere.
 */
import { Image, getImage } from 'astro:assets';
import bird from '../assets/art/bird.jpg';
import theDon from '../assets/commissions/the-don.png';
import mickPosterImg from '../assets/commissions/mick-jagger.png';
import justinPosterImg from '../assets/commissions/justin.png';

// Hannah's finished portrait paintings stand in as the poster frame for each
// timelapse card: the still shows until the clip plays. Optimized down from
// the high-res originals so the heavy page stays cheap.
const mickPoster = await getImage({ src: mickPosterImg, width: 880, quality: 72, format: 'jpg' });
const justinPoster = await getImage({ src: justinPosterImg, width: 880, quality: 72, format: 'jpg' });

const clips = [
  {
    sources: [{ src: '/video/mickjagger.mp4', type: 'video/mp4' }],
    poster: mickPoster.src,
    caption: 'Portrait commission',
    note: 'Painted from your photo',
  },
  {
    sources: [
      { src: '/video/portrait-timelapse-b.webm', type: 'video/webm' },
      { src: '/video/portrait-timelapse-b.mp4', type: 'video/mp4' },
    ],
    poster: justinPoster.src,
    caption: 'Portrait commission',
    note: 'Watch it come together',
  },
];
const stills = [
  { image: theDon, caption: 'Pet portrait', note: 'Dogs, from your photo', alt: 'The Don, a portrait of a black and white Boston Terrier' },
  { image: bird, caption: 'Pet portrait', note: 'Cats, from your photo', alt: 'Bird, a digital painting of a black cat with golden eyes' },
];
---

<section id="commissions" class="section">
  <div class="reveal">
    <h2 class="section-title">Commissions</h2>
    <p class="section-desc">Portraits, pets, and custom pieces. Tell me what you have in mind.</p>
  </div>

  <div class="com-grid reveal">
    {clips.map((c) => (
      <figure class="com-card">
        <div class="com-frame">
          <span class="com-star tl" aria-hidden="true"></span>
          <span class="com-star br" aria-hidden="true"></span>
          <video
            muted
            loop
            playsinline
            preload="none"
            poster={c.poster}
            aria-hidden="true"
            data-autovideo
          >
            {c.sources.map((s) => <source src={s.src} type={s.type} />)}
          </video>
        </div>
        <figcaption class="com-cap">
          <span class="com-type">{c.caption}</span>
          <span class="com-note">{c.note}</span>
        </figcaption>
      </figure>
    ))}
    {stills.map((s) => (
      <figure class="com-card">
        <div class="com-frame">
          <span class="com-star tl" aria-hidden="true"></span>
          <span class="com-star br" aria-hidden="true"></span>
          <Image src={s.image} alt={s.alt} height={520} loading="lazy" />
        </div>
        <figcaption class="com-cap">
          <span class="com-type">{s.caption}</span>
          <span class="com-note">{s.note}</span>
        </figcaption>
      </figure>
    ))}
  </div>

  <figure class="com-card process reveal">
    <div class="com-frame">
      <span class="com-star tl" aria-hidden="true"></span>
      <span class="com-star br" aria-hidden="true"></span>
      <video
        class="process-clip"
        muted
        loop
        playsinline
        preload="none"
        poster="/video/celestial-process-poster.jpg"
        aria-hidden="true"
      >
        <source src="/video/celestial-process.webm" type="video/webm" />
        <source src="/video/celestial-process.mp4" type="video/mp4" />
      </video>
    </div>
    <figcaption class="com-cap">
      <span class="com-type">Process</span>
      <span class="com-note">Watch a piece come to life</span>
    </figcaption>
  </figure>

  <div class="com-cta reveal">
    <a class="btn" href="#contact">Start a commission</a>
  </div>
</section>

<style>
  .com-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-3);
    margin-top: var(--space-4);
    align-items: start;
  }

  .com-card { margin: 0; }

  /* star-framed panel: thin glowing border with two corner stars */
  .com-frame {
    position: relative;
    border: 1px solid rgba(74, 234, 255, 0.3);
    border-radius: var(--radius-md);
    overflow: hidden;
    background: #05071a;
    box-shadow: var(--glow-cyan), var(--shadow-card);
    transition: transform 0.4s ease, box-shadow 0.4s ease;
  }
  .com-card:hover .com-frame {
    transform: translateY(-4px);
    box-shadow: var(--glow-magenta), 0 22px 50px rgba(0, 0, 0, 0.6);
  }
  .com-frame video,
  .com-frame :global(img) {
    width: 100%;
    aspect-ratio: 580 / 860;
    height: auto;
    display: block;
  }
  .com-frame video { object-fit: cover; }
  /* the still portraits show complete and uncropped so the whole piece and
     the artist's signature read; the dark frame letterboxes them. */
  .com-frame :global(img) { object-fit: contain; }

  .com-star {
    position: absolute;
    z-index: 1;
    width: 10px;
    height: 10px;
    background: radial-gradient(circle, #fff 0%, rgba(74, 234, 255, 0.9) 35%, transparent 70%);
    pointer-events: none;
    animation: tw 3.2s ease-in-out infinite;
  }
  .com-star.tl { top: 8px; left: 8px; }
  .com-star.br { bottom: 8px; right: 8px; animation-delay: 1.4s; }

  .com-cap {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 12px 4px 0;
    text-align: center;
  }
  .com-type {
    font-family: var(--font-body);
    font-weight: 500;
    font-size: 14px;
    letter-spacing: 0.08em;
    color: var(--moon);
  }
  .com-note {
    font-family: var(--font-body);
    font-weight: 300;
    font-size: 12px;
    letter-spacing: 0.06em;
    color: rgba(226, 232, 244, 0.55);
  }

  /* the centered process portal under the grid: same celestial frame, its
     clip square and always welcome to loop while on screen */
  .com-card.process {
    max-width: 480px;
    margin: var(--space-4) auto 0;
  }
  .com-card.process .process-clip {
    aspect-ratio: 1;
    object-fit: cover;
  }

  .com-cta { margin-top: var(--space-4); text-align: center; }

  @media (max-width: 900px) {
    .com-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 480px) {
    .com-grid { grid-template-columns: 1fr; max-width: 340px; margin-left: auto; margin-right: auto; }
  }
</style>

<script>
  import { manageVideo } from '../lib/video-client';
  for (const v of Array.from(
    document.querySelectorAll('#commissions video[data-autovideo]')
  ) as HTMLVideoElement[]) {
    manageVideo(v, { group: 'cards' });
  }
  // the process portal joins the same exclusive group so the whole section
  // never runs more than one video at once
  const portal = document.querySelector('.process-clip') as HTMLVideoElement | null;
  if (portal) manageVideo(portal, { group: 'cards' });
</script>
