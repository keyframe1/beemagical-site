---
import Base from '../layouts/Base.astro';
import Starfield from '../components/Starfield.astro';
import Loader from '../components/Loader.astro';
import FaeBee from '../components/FaeBee.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Constellation from '../components/Constellation.astro';
import Featured from '../components/Featured.astro';
import ArtStrip from '../components/ArtStrip.astro';
import Commissions from '../components/Commissions.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import Lightbox from '../components/Lightbox.astro';
import { getArt } from '../lib/art';

// JSON-LD: the artist plus one VisualArtwork per painting
const works = await getArt();
const site = Astro.site?.href ?? 'https://beemagical.art/';
const artist = {
  '@type': 'Person',
  '@id': new URL('#artist', site).href,
  name: 'Bee Magical',
  url: site,
  jobTitle: 'Painter',
  description: 'Space and aurora paintings, plus portrait and pet commissions. Made in Louisiana.',
  sameAs: ['https://www.instagram.com/bee__magical/', 'https://ko-fi.com/bee_magical'],
};
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    artist,
    ...works.map((w) => ({
      '@type': 'VisualArtwork',
      name: w.data.title,
      artMedium: w.data.medium,
      artform: 'Painting',
      ...(w.data.dimensions ? { size: w.data.dimensions } : {}),
      ...(w.data.year ? { dateCreated: String(w.data.year) } : {}),
      description: w.data.note,
      image: new URL(w.data.image.src, site).href,
      creator: { '@id': artist['@id'] },
      url: new URL('#gallery', site).href,
    })),
  ],
};
---

<Base>
  <!-- ambient + intro islands -->
  <Starfield />
  <Loader />
  <FaeBee />

  <Nav />

  <main class="wrap">
    <Hero />
    <div class="div"><span class="ln"></span><span class="d"></span><span class="ln"></span></div>
    <Constellation />
    <Featured />
    <ArtStrip />
    <Commissions />
    <Contact />
  </main>

  <Footer />

  <!-- full-image viewer (island) -->
  <Lightbox />

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
</Base>

<script>
  // scroll-reveal: reveal sections as they enter, staggering elements that
  // arrive in the same observer batch. CSS only hides them when JS is
  // present (html.js), so a no-JS page still shows everything.
  const items = document.querySelectorAll('.reveal');
  if ('IntersectionObserver' in window && items.length) {
    const io = new IntersectionObserver(
      (entries, obs) => {
        let stagger = 0;
        for (const e of entries) {
          if (e.isIntersecting) {
            (e.target as HTMLElement).style.setProperty('--rd', `${stagger * 120}ms`);
            stagger++;
            e.target.classList.add('in');
            obs.unobserve(e.target);
          }
        }
      },
      { threshold: 0.12, rootMargin: '0px 0px -8% 0px' }
    );
    items.forEach((el) => io.observe(el));
  } else {
    items.forEach((el) => el.classList.add('in'));
  }
</script>
