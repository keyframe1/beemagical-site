---
/**
 * Base.astro - document head, fonts, meta, global styles.
 * Wraps every page. Static HTML only; interactive pieces are islands.
 */
import '../styles/global.css';
import Analytics from '@vercel/analytics/astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Bee Magical | Space and aurora paintings, plus portrait and pet commissions',
  description = 'Space and aurora paintings, plus portrait and pet commissions. By Bee Magical, made in Louisiana.',
} = Astro.props;

const ogImage = new URL('/og.jpg', Astro.site).href;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : Astro.url.pathname;

// Share-card copy. The page <title>/description stay long for SEO, but the
// social card leads with the brand name and the tagline so previews read clean.
const ogTitle = 'Bee Magical';
const ogDescription = 'Space and aurora paintings, plus portrait and pet commissions.';
const ogAlt = 'Ultraviolet, a cosmic self-portrait by Bee Magical, set in a starfield.';
---

<!doctype html>
<html lang="en">
  <head>
    <!-- progressive enhancement gate: scroll-reveal only hides when JS runs -->
    <script is:inline>document.documentElement.classList.add('js');</script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />

    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Bee Magical" />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogAlt} />

    <!-- Fonts: Macondo Swash Caps (headings) + Tsukimi Rounded (everything else) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Macondo+Swash+Caps&family=Tsukimi+Rounded:wght@300;400;500;700&display=swap"
      rel="stylesheet"
    />
    <Analytics />
  </head>
  <body>
    <slot />
  </body>
</html>
